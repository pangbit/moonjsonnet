import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/async/fs",
}

async fn main {
  @shell.Cmd("moon", ["package"]).run()
  let archive = @fs.realpath("_build/publish/pangbit-moonjsonnet-0.1.0.zip")
  let listing = @shell.Cmd("unzip", ["-Z1", archive]).output()
  listing.check()
  for required in ["NOTICE", "licenses/GO-BSD-3-Clause.txt", "licenses/GO-MATH-NOTICES.txt", "licenses/YAML-MIT.txt", "internal/yaml/parser.mbt", "stdlib_source.mbt", "unicode_fold.mbt"] {
    assert_true(listing.stdout().split("\n").any(path => path == required), msg="missing archive attribution: " + required)
  }
  for path in listing.stdout().split("\n") {
    assert_true(!path.has_prefix("examples/") && !path.has_prefix("tools/") && !path.has_prefix("tests/") && !path.has_suffix("_test.mbt") && !path.has_suffix("_wbtest.mbt"), msg=path.to_owned())
  }
  let work = @fs.tmpdir(prefix="moonjsonnet-consumer-")
  @fs.mkdir(work + "/package")
  @fs.mkdir(work + "/consumer")
  @shell.Cmd("unzip", ["-q", archive, "-d", work + "/package"]).run()
  @fs.write_file(work + "/consumer/moon.mod", "name = \"pangbit/moonjsonnet_consumer_check\"\nversion = \"0.0.0\"\npreferred_target = \"native\"\nimport { \"pangbit/moonjsonnet@0.1.0\" }\n")
  @fs.write_file(work + "/consumer/moon.pkg", "import { \"pangbit/moonjsonnet\", \"pangbit/moonjsonnet/fs\" } for \"test\"\nsupported_targets = \"native\"\n")
  @fs.write_file(work + "/consumer/native.jsonnet", "std.trace('file consumer',std.native('id')(42))")
