  @fs.write_file(work + "/consumer/consumer_test.mbt", test_source)
  @fs.write_file(work + "/consumer/parameter.jsonnet", "std.extVar('x')")
  @fs.mkdir(work+"/consumer/library")
  @fs.write_file(work+"/consumer/library/answer","42")
  @fs.write_file(work+"/consumer/search.jsonnet","import 'answer'")
  @shell.Cmd("moon", ["work", "init", "package", "consumer"], cwd=work).run()
  @shell.Cmd("moon", ["test", "--target", "native", "--deny-warn"], cwd=work + "/consumer").run()
  println("Archive consumer passed: \{work}")
}
