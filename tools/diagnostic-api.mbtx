import {"moonbitlang/async@0.22.4","moonbitlang/async@0.22.4/fs","moonbitlang/async@0.22.4/shell","moonbitlang/core/env","moonbitlang/core/json"}

fn field(value : Json,key : String,fallback : Json) -> Json {match value {Object(fields)=>fields.get(key).unwrap_or(fallback);_=>fallback}}
async fn command(program : String,args : Array[String]) -> String {let result=@shell.Cmd(program,args).output();result.check();result.stdout().trim().to_owned()}

async fn main {
  let args=@env.args()
  guard args.length()==2 || args.length()==3 || (args.length()==4 && args[3]=="--update") else {fail("Usage: moon run tools/diagnostic-api.mbtx PROBE [GO_CHECKOUT [--update]]")}
  let cli=@fs.realpath(args[1]);let work=@fs.tmpdir(prefix="moonjsonnet-diagnostic-api-");let adapter=@fs.realpath("tests/reference/diagnostic.go");let reference=work+"/go-diagnostic"
  let reference_build=if args.length()>=3 {
    let checkout=@fs.realpath(args[2])
    assert_eq(command("git",["-C",checkout,"rev-parse","HEAD"]),"67968688d9952f50662e979fab1bef889d0d3e57")
    assert_eq(command("git",["-C",checkout,"status","--porcelain"]),"")
    @shell.Cmd("go",["-C",checkout,"build","-o",reference,adapter],env=Map([("GOTOOLCHAIN","go1.24.0"),("GOWORK","off"),("GOPROXY","off")])).run()
    let build=command("go",["version","-m",reference]);assert_true(build.contains("go1.24.0"));build
  } else {"not run; local frozen check"}
  let sources : Array[(String,Json)]=[
    ("success",{"source":"{a:42}"}),
    ("import-syntax",{"source":"import 'library'","files":{"library":"invalid !"}}),
    ("output-string-null",{"source":"null","string_output":true}),
    ("output-string-bool",{"source":"true","string_output":true}),
    ("output-string-number",{"source":"42","string_output":true}),
    ("output-string-array",{"source":"[error 'unused']","string_output":true}),
    ("output-string-object",{"source":"{assert false,a:error 'unused'}","string_output":true}),
    ("output-string-function",{"source":"function() function() 42","string_output":true}),
    ("output-stream-type",{"source":"{a:42}","mode":"stream"}),
    ("output-multi-type",{"source":"[]","mode":"multi"}),
    ("output-multi-string-number",{"source":"{a:42}","mode":"multi","string_output":true}),
    ("output-multi-string-bool",{"source":"{a:true}","mode":"multi","string_output":true}),
    ("output-multi-string-null",{"source":"{a:null}","mode":"multi","string_output":true}),
    ("output-multi-string-array",{"source":"{a:[]}","mode":"multi","string_output":true}),
    ("output-multi-string-object",{"source":"{a:{}}","mode":"multi","string_output":true}),
    ("root",{"source":"error 'failed'"}),
    ("local",{"source":"local x=error 'failed';x"}),
    ("local-body",{"source":"local x=1;error 'failed'"}),
    ("function",{"source":"local f(x)=error x;f('failed')"}),
    ("anonymous-function",{"source":"(function() error 'failed')()"}),
    ("local-function-body",{"source":"local f=local x=1;function() error 'failed';f()"}),
    ("default",{"source":"local f(x=error 'failed')=x;f()"}),
    ("argument",{"source":"local f(x)=x;f(error 'failed')"}),
    ("array",{"source":"[error 'failed']"}),
    ("nested-array",{"source":"[[error 'failed']]"}),
    ("object",{"source":"{a:error 'failed'}"}),
    ("named-object",{"source":"local x={a:error 'failed'};x"}),
    ("object-local",{"source":"{local x=error 'failed',a:x}"}),
    ("object-method",{"source":"local x={f():error 'failed'};x.f()"}),
    ("import",{"source":"import 'library'","files":{"library":"error 'failed'"}}),
    ("import-array",{"source":"[import 'library']","files":{"library":"{a:error 'failed'}"}}),
    ("ext-code",{"source":"std.extVar('x')","ext_code":{"x":"error 'failed'"}}),
    ("parameter-cycle-default",{"source":"std.extVar('x')","ext_code":{"x":"std.extVar('x')"}}),
    ("parameter-cycle-mutual",{"source":"std.extVar('x')","ext_code":{"x":"std.extVar('y')","y":"std.extVar('x')"},"stack_size":8}),
    ("parameter-cycle-conditional",{"source":"std.extVar('x')","ext_code":{"x":"local a=1;if a==1 then std.extVar('x') else 42"},"stack_size":8}),
    ("lazy-cycle-local",{"source":"local x=x; x","stack_size":8}),
    ("lazy-cycle-binary",{"source":"local x=1+x; x","stack_size":8}),
    ("lazy-cycle-field",{"source":"local x={a:self.a}; x.a","stack_size":8}),
    ("lazy-cycle-array",{"source":"local x=[x[0]];x[0]","stack_size":8}),
    ("lazy-cycle-closure",{"source":"local f(x)=x; local x=f(x); x","stack_size":8}),
    ("lazy-cycle-generated",{"source":"local x=std.makeArray(1,function(i) x[0]);x[0]","stack_size":8}),
    ("lazy-cycle-additive",{"source":"local x={a:1}+{a+:self.a};x.a","stack_size":8}),
    ("lazy-cycle-ext-binary",{"source":"std.extVar('x')","ext_code":{"x":"1+std.extVar('x')"},"stack_size":8}),
    ("lazy-cycle-ext-local",{"source":"std.extVar('x')","ext_code":{"x":"local a=1+std.extVar('x');a"},"stack_size":8}),
    ("tla-code",{"source":"function(x) x","tla_code":{"x":"error 'failed'"}}),
    ("tla-body",{"source":"function() error 'failed'"}),
    ("syntax-token",{"source":"[1 2]"}),
    ("syntax-eof",{"source":"[1,"}),
    ("static-variable",{"source":"unknown"}),
    ("syntax-unicode",{"source":"'é中\\u12xz'"}),
    ("recursion",{"source":"local f(n)=if n==0 then error 'failed' else f(n-1);f(25)"}),
    ("tailstrict",{"source":"local f(n)=if n==0 then error 'failed' else f(n-1) tailstrict;f(25) tailstrict"}),
    ("stream",{"source":"[error 'failed']","mode":"stream"}),
    ("multi",{"source":"{a:error 'failed'}","mode":"multi"}),
    ("additive",{"source":"{a:1}+{a+:error 'failed'}"}),
    ("assert",{"source":"assert false:'failed';42"}),
    ("object-assert",{"source":"{assert false:'failed',a:42}"}),
    ("object-assert-comment",{"source":"{assert /*begin*/\n  false : 'failed',\n a:42}"}),
    ("closure-alias",{"source":"local f()=error 'failed',g=f;g()"}),
    ("conditional-function",{"source":"local f=if true then function() error 'failed' else null;f()"}),
    ("nested-object",{"source":"local x={a:{b:error 'failed'}};x"}),
    ("unicode-file",{"source":"local 中=1;error 'failed'","filename":"path/中"}),
    ("syntax-crlf",{"source":"[1,\r\n2 3]"}),
    ("syntax-computed-import",{"source":"import ('a'+\n'b')"}),
    ("error-number",{"source":"error 1"}),
    ("error-boolean",{"source":"error true"}),
    ("error-null",{"source":"error null"}),
    ("error-empty-array",{"source":"error []"}),
    ("error-empty-object",{"source":"error {}"}),
    ("error-array",{"source":"error [1,false,null]"}),
    ("error-object",{"source":"error {b:2,a:1,hidden::error 'unused'}"}),
    ("error-controls",{"source":"error ['\\u007f\\u0080\\u009f']"}),
    ("error-function",{"source":"error function() 42"}),
    ("error-nested",{"source":"error [error 'nested']"}),
    ("assert-number",{"source":"assert false:1;42"}),
    ("assert-array",{"source":"assert false:[1,2];42"}),
    ("assert-object",{"source":"assert false:{a:1};42"}),
    ("assert-default-message",{"source":"assert false;42"}),
    ("assert-lazy-message",{"source":"assert true:error 'unused';42"}),
    ("object-assert-number",{"source":"{assert false:1,a:42}"}),
    ("object-assert-array",{"source":"{assert false:[1,2],a:42}"}),
    ("object-assert-object",{"source":"{assert false:{a:1},a:42}"}),
    ("object-assert-default-message",{"source":"{assert false,a:42}"}),
    ("object-assert-lazy-message",{"source":"{assert true:error 'unused',a:42}"}),
    ("boundary-length-argument",{"source":"std.length(error 'failed')"}),
    ("boundary-map",{"source":"std.map(function(x) error 'failed',[1])"}),
    ("boundary-filter",{"source":"std.filter(function(x) error 'failed',[1])"}),
    ("boundary-fold",{"source":"std.foldl(function(a,b) error 'failed',[1],0)"}),
    ("boundary-sort",{"source":"std.sort([2,1],function(x) error 'failed')"}),
    ("boundary-range",{"source":"std.range(error 'failed',3)"}),
    ("boundary-trace",{"source":"std.trace(error 'failed',42)"}),
    ("boundary-assert-equal",{"source":"std.assertEqual(1,2)"}),
    ("boundary-json",{"source":"std.parseJson('{')"}),
    ("boundary-yaml",{"source":"std.parseYaml('[broken')"}),
    ("boundary-length-type",{"source":"std.length(42)"}),
    ("boundary-floor",{"source":"std.floor('x')"}),
    ("boundary-unknown-standard-field",{"source":"std.substring('abc',-1,1)"}),
    ("boundary-array-comp-body",{"source":"[error 'failed' for x in [1]]"}),
    ("boundary-array-comp-source",{"source":"[x for x in error 'failed']"}),
    ("boundary-array-comp-condition",{"source":"[x for x in [1] if error 'failed']"}),
    ("boundary-object-comp-body",{"source":"{[x]:error 'failed' for x in ['a']}"}),
    ("boundary-object-comp-key",{"source":"{[error 'failed']:42 for x in ['a']}"}),
    ("boundary-index-argument",{"source":"[1,2][error 'failed']"}),
    ("boundary-slice-argument",{"source":"[1,2][::error 'failed']"}),
    ("boundary-slice-zero",{"source":"[1,2][0:1:0]"}),
    ("boundary-additive",{"source":"{a:1}+{a+:error 'failed'}"}),
    ("boundary-call-missing",{"source":"local f(x)=x;f()"}),
    ("boundary-call-extra",{"source":"local f(x)=x;f(1,2)"}),
    ("boundary-call-name",{"source":"local f(x)=x;f(y=1)"}),
    ("builtin-call-missing",{"source":"std.length()"}),
    ("builtin-call-extra",{"source":"std.length(error 'unused',error 'unused')"}),
    ("builtin-call-name",{"source":"std.length(unknown=error 'unused')"}),
    ("builtin-call-duplicate",{"source":"std.length(error 'unused',x=error 'unused')"}),
    ("builtin-call-ternary-missing",{"source":"std.substr(len=1)"}),
    ("builtin-call-optional-missing",{"source":"std.manifestJsonEx(indent='')"}),
    ("builtin-call-optional-duplicate",{"source":"std.manifestJsonEx(1,'',value=2)"}),
    ("builtin-call-sort-missing",{"source":"std.sort(keyF=function(x) x)"}),
    ("closure-call-duplicate",{"source":"(function(x) x)(error 'unused',x=error 'unused')"}),
    ("closure-call-extra-precedence",{"source":"(function(x) x)(0,1,x=2)"}),
    ("boundary-add-type",{"source":"true+1"}),
    ("boundary-division-zero",{"source":"1/0"}),
    ("boundary-field-missing",{"source":"{a:1}.missing"}),
    ("boundary-index-bounds",{"source":"[1][2]"}),
    ("boundary-error-number",{"source":"error 1"}),
    ("boundary-assert-type",{"source":"assert 1;42"}),
    ("boundary-object-assert-type",{"source":"{assert 1,a:42}"}),
    ("boundary-field-assert",{"source":"local o={assert false:'failed',a:1};o.a"}),
    ("boundary-json-manifest",{"source":"std.manifestJson({a:error 'failed'})"}),
    ("boundary-object-fields",{"source":"std.objectFields(error 'failed')"}),
    ("boundary-get-lazy",{"source":"std.get({a:1},'a',error 'failed')"}),
    ("boundary-recursion",{"source":"local f(n)=if n==0 then error 'failed' else f(n-1);f(3)"}),
    ("boundary-self",{"source":"local o={a:self.b,b:error 'failed'};o.a"}),
  ]
  let json_errors=[""," ","{","[","\"","-","1.","1e","1e+","t","tr","tru","truth","falsex","nullx","nul","{x:1}","{\"x\"1}","{\"x\":}","{\"x\":1 x}","[1 x]","[1,]","{\"x\":1,}","\"\\q\"","\"\\u12xz\"","\"control\n\"","true false","01","--1","é","\u007f","[true}"]
  for stack in [1,2,3,8] {
    sources.push(("parameter-cycle-stack-"+stack.to_string(),{"source":"std.extVar('x')","ext_code":{"x":"std.extVar('x')"},"stack_size":stack}))
  }
  for index,data in json_errors {
    sources.push(("json-error-"+index.to_string(),{"source":"std.parseJson("+Json::string(data).stringify()+")"}))
  }
  let yaml_inputs=["[","[broken","{broken","[\n broken","a:\n [broken","[{broken]","{a: [broken}","- a\n b","[\n,\n]","*missing","\"\\q\"","%YAML 1.1\n%YAML 1.1\n---\na","!unknown!a x","\u0001","a:\n\t1","root:\n  - a\n wrong","%YAML 1.2\n---\na","%TAG !a! tag:example.com,2026:\n%TAG !a! tag:other.com,2026:\n---\nx","%YAML 1.1\n---\na","%TAG !a! tag:example.com,2026:\n%TAG !b! tag:other.com,2026:\n---\n!a!foo x"]
  for index,data in yaml_inputs {
    sources.push(("yaml-diagnostic-"+index.to_string(),{"source":"std.parseYaml("+Json::string(data).stringify()+")"}))
  }
  let inputs : Array[Json]=[]
  for (name,source) in sources {
    for size in [Json::null(),Json::number(-1),Json::number(0),Json::number(1),Json::number(2),Json::number(3),Json::number(2147483647)] {
      let input=match source {Object(fields)=>fields.copy();_=>Map([])}
      input["name"]=Json::string(name);input["trace_size"]=size
      inputs.push(Json::object(input))
    }
  }
  for (name,source) in sources {
    if name.has_prefix("syntax") || name=="static-variable" || name=="object" {
      let input=match source {Object(fields)=>fields.copy();_=>Map([])}
      input["name"]=Json::string(name+"-color");input["color"]=true
      inputs.push(Json::object(input))
    }
  }
  let frozen=if args.length()==4 {[]} else {guard @json.parse(@fs.read_file("tests/go-diagnostic-api.json").text()) is Array(cases) else {fail("diagnostic fixtures")};assert_eq(cases.length(),inputs.length());cases}
  let fixtures : Array[Json]=[];let rows : Array[Json]=[];let mut passed=0;let mut reference_errors=0;let mut local_errors=0
  for i,input in inputs {
    let expected=if args.length()>=3 {let output=@shell.Cmd(reference,[],stdin=@shell.Text(input.stringify())).output(timeout_ms=10000);output.check();assert_eq(output.stderr(),"");@json.parse(output.stdout())}
      else {guard frozen[i] is {"input":saved,"expected":expected,..} else {fail("fixture")};assert_eq(saved,input);expected}
    fixtures.push({"input":input,"expected":expected})
    if args.length()!=4 {assert_eq(fixtures[i],frozen[i])}
    let output=@shell.Cmd(cli,[],stdin=@shell.Text(input.stringify())).output(timeout_ms=10000)
    let actual=try @json.parse(output.stdout()) catch {_=>Json::null()}
    if field(expected,"error",false)==Json::boolean(true) {reference_errors+=1}
    if field(actual,"error",false)==Json::boolean(true) {local_errors+=1}
    let ok=output.exit_code()==0 && output.stderr()=="" && expected==actual
    if ok {passed+=1} else {println("FAIL diagnostic "+field(input,"name",null).stringify()+" size="+field(input,"trace_size",null).stringify()+"; complete bytes/frames retained in report")}
    rows.push({"input":input,"expected":expected,"actual":actual,"passed":ok,"exit":output.exit_code(),"stderr":output.stderr()})
  }
  if args.length()==4 {@fs.write_file("tests/go-diagnostic-api.json",Json::array(fixtures).stringify(indent=2)+"\n")}
  @fs.mkdir("_build/diagnostic-api",recursive=true,allow_exist=true)
  let commit=@shell.Cmd("git",["rev-parse","HEAD"]).output();let dirty=@shell.Cmd("git",["status","--porcelain"]).output()
  let report : Json={"source_commit":if commit.exit_code()==0 {Json::string(commit.stdout().trim().to_owned())} else {Json::null()},"source_dirty":if dirty.exit_code()==0 {Json::boolean(!dirty.stdout().is_empty())} else {Json::null()},"reference_commit":"67968688d9952f50662e979fab1bef889d0d3e57","fresh_go_reference":args.length()>=3,"reference_build":reference_build,
    "reference_sha256":if args.length()>=3 {command("shasum",["-a","256",reference])} else {"not run"},"local_sha256":command("shasum",["-a","256",cli]),"adapter_sha256":command("shasum",["-a","256",adapter]),"fixture_sha256":command("shasum",["-a","256","tests/go-diagnostic-api.json"]),
    "comparison":"complete bytes, ordered named/synthetic trace frames, error/output and color calls","total":inputs.length(),"passed":passed,"failed":inputs.length()-passed,"reference_errors":reference_errors,"local_errors":local_errors,"skipped":0,"unsupported":0,"declared_exceptions":0,"cases":rows}
  let path=if args.length()>=3 {"_build/diagnostic-api/report.json"} else {"_build/diagnostic-api/local-report.json"}
  @fs.write_file(path,report.stringify(indent=2)+"\n")
  println("Diagnostic API: \{passed}/\{inputs.length()}; errors Go=\{reference_errors}, local=\{local_errors}; evidence: "+work)
  if passed!=inputs.length() {fail("diagnostic differences retained")}
}
