----
import {"moonbitlang/async@0.22.4","moonbitlang/async@0.22.4/fs","moonbitlang/async@0.22.4/shell","moonbitlang/core/env"}
----
async fn main {
  let args=@env.args();guard args.length()==2 else {fail("Usage: moon run tools/embed-lint-stdlib.mbtx GO_CHECKOUT")}
  let root=args[1]
  let commit=@shell.Cmd("git",["-C",root,"rev-parse","HEAD"]).output();commit.check()
  assert_eq(commit.stdout().trim().to_owned(),"67968688d9952f50662e979fab1bef889d0d3e57")
  let dirty=@shell.Cmd("git",["-C",root,"status","--porcelain"]).output();dirty.check();assert_eq(dirty.stdout(),"")
  let file=root+"/linter/internal/types/stdlib.go"
  let source=@fs.read_file(file).text()
  let hash=@shell.Cmd("shasum",["-a","256",file]).output();hash.check()
  assert_true(hash.stdout().has_prefix("7415471787cacf18fc890ba31b8b478190731bc6f628aa57aa90219a6cbf051e "))
  let ids : Map[String,Int]=Map([("anyType",1),("boolType",2),("numberType",3),("stringType",4),("nullType",5),("anyArrayType",6),("numberArrayType",7),("boolArrayType",8),("anyObjectType",9),("anyFunctionType",10),("arrayOfString",6),("stringOrArray",1),("stringOrNumber",1),("jsonType",1)])
  let out=StringBuilder()
  out.write_string("// Generated by tools/embed-lint-stdlib.mbtx from go-jsonnet v0.21.0.\n// Copyright Google Inc.; Apache-2.0; see NOTICE.\n// Source SHA-256: "+hash.stdout().split(" ").next().unwrap().to_owned()+"\n///|\nfn LintGraph::stdlib(self : LintGraph) -> Unit {\nlet fields : Map[String,Array[Int]]=Map([])\n")
  let mut count=0
  for line in source.split("\n") {
    let line=line.trim().to_owned()
    if !line.has_prefix("\"") {continue}
    let words=line.split("\"").map(s=>s.to_owned()).collect()
    let name=words[1]
    if name=="thisFile" {out.write_string("fields[\"thisFile\"]=[4]\n");count+=1;continue}
    let simple=line.contains("g.newSimpleFuncType(")
    guard simple || line.contains("g.newFuncType(") else {fail("unrecognized stdlib entry: "+line)}
    let tail=line.split("(").collect()[1]
    let result=tail.split(",").collect()[0].trim().to_owned()
    let params=[]
    for i=3;i<words.length();i=i+2 {
      let name=words[i]
      params.push("(\""+name+"\","+line.contains("optional(\""+name+"\")").to_string()+")")
    }
    out.write_string("fields[\""+name+"\"]=[self.function(\{ids[result]},["+params.join(",")+"],\{simple})]\n")
    count+=1
  }
  out.write_string("self.slots[11].concrete.object=Some({fields,unknown:[],known:true})\n}\n")
  assert_eq(count,142)
  @fs.write_file("lint_type_stdlib.mbt",out.to_string())
  println("Generated \{count} pinned lint standard-library entries")
}
