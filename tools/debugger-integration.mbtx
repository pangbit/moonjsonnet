----
import {"moonbitlang/async@0.22.4","moonbitlang/async@0.22.4/fs","moonbitlang/async@0.22.4/shell","moonbitlang/core/env","moonbitlang/core/json"}
----

fn field(value : Json,key : String,fallback : Json) -> Json {match value {Object(fields)=>fields.get(key).unwrap_or(fallback);_=>fallback}}
async fn command(program : String,args : Array[String]) -> String {let result=@shell.Cmd(program,args).output();result.check();result.stdout().trim().to_owned()}

async fn main {
  let args=@env.args()
  guard args.length()==2 || args.length()==3 || (args.length()==4 && args[3]=="--update") else {fail("Usage: moon run tools/debugger-integration.mbtx PROBE [GO_CHECKOUT [--update]]")}
  let cli=@fs.realpath(args[1]);let work=@fs.tmpdir(prefix="moonjsonnet-debugger-");let adapter=@fs.realpath("tests/reference/debugger.go");let reference=work+"/go-debugger"
  let reference_build=if args.length()>=3 {
    let checkout=@fs.realpath(args[2])
    assert_eq(command("git",["-C",checkout,"rev-parse","HEAD"]),"67968688d9952f50662e979fab1bef889d0d3e57")
    assert_eq(command("git",["-C",checkout,"status","--porcelain"]),"")
    @shell.Cmd("go",["-C",checkout,"build","-o",reference,adapter],env=Map([("GOTOOLCHAIN","go1.24.0"),("GOWORK","off"),("GOPROXY","off")])).run()
    let build=command("go",["version","-m",reference]);assert_true(build.contains("go1.24.0"));build
  } else {"not run; local frozen check"}
  let inputs : Array[Json]=[
    {"name":"breakpoint-number","source":"local x=21;\nx*2","line":2,"lookups":["x"]},
    {"name":"breakpoint-string","source":"local x='hello';\nx+'!'","line":2,"lookups":["x"]},
    {"name":"breakpoint-boolean","source":"local x=true;\nif x then 42 else 0","line":2,"lookups":["x"]},
    {"name":"breakpoint-null","source":"local x=null;\nif x==null then 42 else 0","line":2,"lookups":["x"]},
    {"name":"breakpoint-invalid-name","source":"local x=21;\nx*2","line":2,"lookups":["missing"]},
    {"name":"breakpoint-unused","source":"local x=21,unused=error 'unused';\nx*2","line":2,"lookups":["x"]},
    {"name":"step-conditional","source":"if true then 21*2 else error 'unused'","commands":["step","step","step","step"]},
    {"name":"step-local","source":"local x=21;x*2","commands":["step","step","step","step"]},
    {"name":"step-function","source":"local f(x)=x+1;f(41)","commands":["step","step","step","step","step","step"]},
    {"name":"finish-function","source":"local f(x)=x+1;[f(20),f(41)]","commands":["step","step","finish","finish"]},
    {"name":"finish-root","source":"local x=21;x*2","commands":["finish"]},
    {"name":"exception-root","source":"error 'failed'"},
    {"name":"exception-function","source":"local f()=error 'failed';f()"},
    {"name":"exception-unused","source":"local unused=error 'unused';42"},
    {"name":"terminated","source":"local x=42;x","commands":["terminate"]},
    {"name":"invalid-breakpoint","source":"21*2","line":99},
    {"name":"capture-outer","source":"local y=21,f(x)=x+y;f(21)","commands":["step","step","step","step","step","step"],"lookups":["y"]},
    {"name":"capture-default","source":"local f(x=21)=x;f()","commands":["step","step","step","step","step","step"],"lookups":["x"]},
    {"name":"shadow-local","source":"local x=1;local x=21;x*2","commands":["step","step","step","step"]},
    {"name":"capture-array","source":"local x=21;[x*2]","commands":["step","step","step","step"]},
    {"name":"capture-named","source":"local f(x)=x;f(x=42)","commands":["step","step","step","step","step"]},
    {"name":"capture-lazy","source":"local f(x)=42;f(error 'unused')","commands":["step","step","step","step","step"]},
    {"name":"capture-recursion","source":"local f(x)=if x==0 then 42 else f(x-1);f(2)","commands":["step","step","step","step","step","step","step","step"]},
    {"name":"capture-object","source":"local x=21,unused=0;{a:x*2}","commands":["step","step","step","step","step"]},
    {"name":"capture-object-local","source":"local x=21;{local y=x,a:y*2}","commands":["step","step","step","step","step","step"]},
    {"name":"capture-object-function","source":"local x=21;{f(y):x+y}.f(21)","commands":["step","step","step","step","step","step","step","step"]},
  ]
  for (name,source,line,column) in [
    ("parentheses","local x=21;\n((x*2))",2,3),
    ("assert","assert 1+1==2 : 'bad';\n21*2",1,8),
    ("array-comp","local n=2;\n[x*2 for x in [1,n] if x>0]",2,1),
    ("object-comp","local n=2;\n{[std.toString(x)]: x*2 for x in [1,n] if x>0}",2,1),
    ("slice","local a=[0,21,42];\na[1+0:3:1]",2,1),
  ] {
    for (mode,commands) in [("continue",[]),("step",["step","step","step","step","step","step","step","step"]),("finish",["finish","finish"])] {
      inputs.push({"name":"mapping-"+name+"-"+mode,"source":source,"line":line,"column":column,"locations":true,"commands":commands})
    }
  }
  inputs.push({"name":"mapping-parentheses-invalid","source":"local x=21;\n((x*2))","line":2,"column":1,"locations":true})
  inputs.push({"name":"mapping-assert-failed","source":"assert 1+1==3 : 'bad';\n21*2","line":1,"column":1,"locations":true})
  let frozen=if args.length()==4 {[]} else {guard @json.parse(@fs.read_file("tests/go-debugger.json").text()) is Array(cases) else {fail("debugger fixtures")};assert_eq(cases.length(),inputs.length());cases}
  let fixtures : Array[Json]=[];let rows : Array[Json]=[];let mut passed=0;let mut reference_errors=0;let mut local_errors=0
  for i,input in inputs {
    let expected=if args.length()>=3 {
      let output=@shell.Cmd(reference,[],stdin=@shell.Text(input.stringify())).output(timeout_ms=10000);output.check();assert_eq(output.stderr(),"")
      @json.parse(output.stdout())
    } else {guard frozen[i] is {"input":saved,"expected":expected,..} else {fail("debugger fixture")};assert_eq(saved,input);expected}
    fixtures.push({"input":input,"expected":expected})
    if args.length()!=4 {assert_eq(fixtures[i],frozen[i])}
    let output=@shell.Cmd(cli,[],stdin=@shell.Text(input.stringify())).output(timeout_ms=10000)
    let actual=try @json.parse(output.stdout()) catch {_=>Json::null()}
    if field(field(expected,"result",null),"error",false)==Json::boolean(true) {reference_errors+=1}
    if field(field(actual,"result",null),"error",false)==Json::boolean(true) {local_errors+=1}
    let ok=output.exit_code()==0 && output.stderr()=="" && field(expected,"result",null)==field(actual,"result",null)
    if ok {passed+=1} else {println("FAIL debugger "+input.stringify()+" actual="+actual.stringify()+" expected="+expected.stringify())}
    rows.push({"input":input,"expected":expected,"actual":actual,"passed":ok,"exit":output.exit_code(),"stderr":output.stderr()})
  }
  if args.length()==4 {@fs.write_file("tests/go-debugger.json",Json::array(fixtures).stringify(indent=2)+"\n")}
  @fs.mkdir("_build/debugger",recursive=true,allow_exist=true)
  let commit=@shell.Cmd("git",["rev-parse","HEAD"]).output();let dirty=@shell.Cmd("git",["status","--porcelain"]).output()
  let report : Json={"source_commit":if commit.exit_code()==0 {Json::string(commit.stdout().trim().to_owned())} else {Json::null()},"source_dirty":if dirty.exit_code()==0 {Json::boolean(!dirty.stdout().is_empty())} else {Json::null()},"reference_commit":"67968688d9952f50662e979fab1bef889d0d3e57","fresh_go_reference":args.length()>=3,"reference_build":reference_build,
    "reference_sha256":if args.length()>=3 {command("shasum",["-a","256",reference])} else {"not run"},"local_sha256":command("shasum",["-a","256",cli]),"adapter_sha256":command("shasum",["-a","256",adapter]),"fixture_sha256":command("shasum",["-a","256","tests/go-debugger.json"]),
    "comparison":"complete result: ordered stops/ranges/variables/lookup values, output/error flag, breakpoint status; diagnostic text retained separately and not claimed equal","total":inputs.length(),"passed":passed,"failed":inputs.length()-passed,"reference_errors":reference_errors,"local_errors":local_errors,"skipped":0,"unsupported":0,"declared_exceptions":0,"cases":rows}
  let path=if args.length()>=3 {"_build/debugger/report.json"} else {"_build/debugger/local-report.json"}
  @fs.write_file(path,report.stringify(indent=2)+"\n")
  println("Debugger: \{passed}/\{inputs.length()}; error outcomes Go=\{reference_errors}, local=\{local_errors}; evidence: "+work)
  if passed!=inputs.length() {fail("debugger differences retained")}
}
