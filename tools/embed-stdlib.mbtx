import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

async fn main {
  let args = @env.args()
  guard args.length() == 2 else { fail("Usage: moon run tools/embed-stdlib.mbtx GO_CHECKOUT") }
  let revision = @shell.Cmd("git", ["-C", args[1], "rev-parse", "HEAD"]).output()
  revision.check()
  assert_eq(revision.stdout().trim().to_owned(), "67968688d9952f50662e979fab1bef889d0d3e57")
  let diff = @shell.Cmd("git", ["-C", args[1], "diff", "HEAD", "--", "astgen/stdast.go"]).output()
  diff.check()
  assert_true(diff.stdout().is_empty())
  let ast = @fs.read_file(args[1] + "/astgen/stdast.go").text()
  let source = StringBuilder()
  let mut started = false
  let mut finished = false
  for line in ast.split("\n") {
    if line == "\tLines: []string{" { started = true; continue }
    if started {
      if line == "\t}," { finished = true; break }
      let quoted = line.trim().to_owned()
      assert_true(quoted.has_suffix(","))
      guard @json.parse(quoted[:quoted.length() - 1]) is String(text) else { fail("invalid source line") }
      source.write_string(text)
    }
  }
  assert_true(finished)
  let embedded = StringBuilder()
  embedded.write_string("// Generated by tools/embed-stdlib.mbtx; do not edit.\n// Google Jsonnet stdlib, Apache-2.0; see NOTICE and the embedded header.\n\n///|\nfn standard_library_source() -> String {\n  (\n")
  for line in source.to_string().split("\n") {
    embedded.write_string("    #|" + line.to_owned() + "\n")
  }
  embedded.write_string("  )\n}\n")
  @fs.write_file("stdlib_source.mbt", embedded.to_string())
  println("Embedded the pinned Jsonnet standard-library source; enabled fields are selected separately.")
}
