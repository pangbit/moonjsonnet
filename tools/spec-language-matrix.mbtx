///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn checked(program : String, args : Array[String]) -> String {
  let result = @shell.Cmd(program, args).output(timeout_ms=10000)
  result.check()
  result.stdout().trim().to_owned()
}

///|
async fn sha256(path : String) -> String {
  checked("shasum", ["-a", "256", path]).split(" ").next().unwrap().to_owned()
}

///|
fn field(value : Json, key : String) -> Json {
  guard value is Object(fields) else { abort("object required") }
  fields.get(key).unwrap()
}

///|
fn text_field(value : Json, key : String) -> String {
  guard field(value, key) is String(text) else {
    abort("string required: " + key)
  }
  text
}

///|
fn normalized(text : String) -> String {
  let out = StringBuilder()
  let mut space = false
  for c in text {
    if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
      space = true
    } else {
      if space {
        out.write_char(' ')
      }
      space = false
      out.write_char(c)
    }
  }
  out.to_string()
}

///|
fn dimension(row : Json, name : String) -> Array[Json] {
  guard row is Object(fields) else { abort("coverage row") }
  match fields.get(name) {
    None => []
    Some(Array(values)) => values
    _ => abort("dimension must be an evidence array: " + name)
  }
}

///|
fn evidence_ids(row : Json) -> Array[String] {
  let ids : Array[String] = []
  for name in ["normal", "static_error", "runtime_error", "lazy", "boundary"] {
    for value in dimension(row, name) {
      guard value is String(id) else { abort("evidence ID must be string") }
      if !ids.contains(id) {
        ids.push(id)
      }
    }
  }
  ids
}

///|
fn rule_review(row : Json) -> Json? {
  guard row is Object(fields) else { abort("coverage row") }
  fields.get("rule_review")
}

///|
fn dimension_text(row : Json, name : String) -> String {
  let ids = dimension(row, name).map(value => {
    match value {
      String(id) => "[" + id + "](#assertion-evidence)"
      _ => abort("evidence ID")
    }
  })
  if ids.is_empty() {
    if rule_review(row) is Some(review) &&
      field(review, "not_applicable") is Object(reasons) &&
      reasons.contains(name) {
      "N/A (named rule)"
    } else {
      "unreviewed"
    }
  } else {
    ids.join(", ")
  }
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    fail(
      "Usage: moon run --frozen tools/spec-language-matrix.mbtx REFERENCE_DIR EVIDENCE_DIR",
    )
  }
  let pinned = "bbb38f1020be1f5aed560928fb839b2c448cefb4"
  let reference = args[1]
  let output = args[2]
  let spec_hash = "bbac3701ef0316fc29de6c543049ae8f0f78c876bdd94fbf6ab845b2023a720a"
  let language_hash = "c55666af13894c8100c84fb053e647cd0ca516f3bb554d0ced29dfa83c3772be"
  assert_eq(sha256(reference + "/spec.html"), spec_hash)
  assert_eq(sha256(reference + "/language.md"), language_hash)
  let spec = @fs.read_file(reference + "/spec.html").text()
  let mapping_path = "tests/spec-language-coverage.json"
  let mapping = @json.parse(@fs.read_file(mapping_path).text())
  assert_eq(text_field(mapping, "spec_commit"), pinned)
  guard field(mapping, "evidence") is Object(evidence) else {
    fail("evidence table")
  }
  guard field(mapping, "rules") is Object(mapped_rules) else {
    fail("rule table")
  }
  guard field(mapping, "clauses") is Array(clauses) else {
    fail("clause table")
  }
  let test_hashes : Map[String, Json] = Map([])
  let locations : Map[String, Json] = Map([])
  for id, item in evidence {
    let path = text_field(item, "file")
    let source = @fs.read_file(path).text()
    test_hashes[path] = Json::string(sha256(path))
    let declaration = "test \"" + text_field(item, "test") + "\" {"
    let fragments = source.split(declaration).collect()
    assert_eq(fragments.length(), 2, msg="unique test declaration for " + id)
    let block = normalized(
      fragments[1].split("\n///|").next().unwrap().to_owned(),
    )
    guard field(item, "assertions") is Array(assertions) else {
      fail("assertion list")
    }
    assert_true(
      !assertions.is_empty(),
      msg="explicit assertion anchors for " + id,
    )
    assert_true(
      !text_field(item, "checks").is_empty(),
      msg="manual semantic explanation for " + id,
    )
    for value in assertions {
      guard value is String(assertion) else { fail("assertion text") }
      assert_true(
        block.contains(normalized(assertion)),
        msg="assertion anchor changed: " + id + ": " + assertion,
      )
    }
    let line = fragments[0].split("\n").count()
    locations[id] = {
      "file": path,
      "line": line,
      "test": text_field(item, "test"),
      "assertions": assertions,
      "checks": text_field(item, "checks"),
      "status": "manually reviewed assertion subset; execution is separate",
    }
  }
  let rule_lines : Map[String, Int] = Map([])
  let sections : Map[String, Int] = Map([])
  for i, line in spec.split("\n").collect() {
    if line.contains("<h") && line.contains(" id=\"") {
      let anchor = line.split(" id=\"").collect()[1]
        .split("\"")
        .next()
        .unwrap()
        .to_owned()
      sections[anchor] = i + 1
    }
    if line.contains("\\rule{") {
      let rule = line.split("\\rule{").collect()[1]
        .split("}")
        .next()
        .unwrap()
        .to_owned()
      assert_true(
        !rule_lines.contains(rule),
        msg="duplicate source rule " + rule,
      )
      rule_lines[rule] = i + 1
    }
  }
  assert_eq(rule_lines.length(), 70, msg="pinned named-rule inventory")
  for name, _ in mapped_rules {
    assert_true(
      rule_lines.contains(name),
      msg="mapping names an absent rule: " + name,
    )
  }
  let rows : Array[Json] = []
  for name, line in rule_lines {
    let section = if name.has_prefix("chk-") {
      "static_checking"
    } else if name.has_prefix("manifest-") {
      "manifestation"
    } else {
      "execution"
    }
    let row = mapped_rules
      .get(name)
      .unwrap_or({
        "remaining": "No manually reviewed assertions assigned. Normal, static/runtime errors, lazy and boundary obligations remain unreviewed.",
        "implementation": [],
      })
    rows.push({
      "id": name,
      "section": section,
      "source_line": line,
      "kind": "named-rule",
      "coverage": row,
    })
  }
  let clause_ids : Map[String, Bool] = Map([])
  for clause in clauses {
    let id = text_field(clause, "id")
    let section = text_field(clause, "section")
    assert_true(
      sections.contains(section),
      msg="unknown source anchor " + section,
    )
    assert_true(!clause_ids.contains(id), msg="duplicate clause " + id)
    clause_ids[id] = true
    rows.push({
      "id": id,
      "section": section,
      "source_line": sections[section],
      "kind": "prose-or-grammar-obligation",
      "coverage": clause,
    })
  }
  let source_base = "https://github.com/google/jsonnet/blob/" +
    pinned +
    "/doc/ref/spec.html"
  let markdown = StringBuilder()
  markdown.write_string("# Language clause matrix\n\n")
  markdown.write_string(
    "Generated by [spec-language-matrix.mbtx](../../tools/spec-language-matrix.mbtx) from [manual assertion mappings](../../tests/spec-language-coverage.json). ",
  )
  markdown.write_string(
    "Fixed [specification](" +
    source_base +
    ") and [language reference](https://github.com/google/jsonnet/blob/" +
    pinned +
    "/doc/ref/language.html.md).\n\n",
  )
  markdown.write_string(
    "All 70 named inference rules are enumerated, including specification builtins. The additional prose/grammar rows are an initial obligation inventory, not a claim that every prose/desugaring clause has been decomposed. ",
  )
  markdown.write_string(
    "Populated cells identify manually examined assertions. Empty cells remain unreviewed. Explicit completed-rule reviews below concern only their named judgments; N/A cells have stated in-rule reasons, not missing passing tests. Runtime errors include host Type/Assertion categories after successful parsing. ",
  )
  markdown.write_string(
    "Independent outcomes are in [the initial language report](SPEC-LANGUAGE-EVIDENCE-2026-10-22.md), [recursive binding/comprehension report](SPEC-LANGUAGE-FORMS-EVIDENCE-2026-10-22.md), [application entry-path report](SPEC-LANGUAGE-CALL-EVIDENCE-2026-10-22.md), [static importstr report](SPEC-IMPORTSTR-STATIC-EVIDENCE-2026-10-22.md), [binary byte-substitution report](SPEC-IMPORTBIN-BYTES-EVIDENCE-2026-10-22.md), [UTF-8 text-substitution report](SPEC-IMPORTSTR-UTF8-EVIDENCE-2026-10-22.md) and [conditional-rule report](SPEC-CONDITIONAL-EVIDENCE-2026-10-22.md); [Go/C++ comparison](SPEC-LANGUAGE-COMPARISON-2026-10-22.md) is separate. Whole-language conformance remains incomplete.\n\n",
  )
  markdown.write_string(
    "Reproduce with `moon run --frozen tools/spec-language-matrix.mbtx REFERENCE_DIR EVIDENCE_DIR`; REFERENCE_DIR supplies pinned spec.html and language.md. This command validates assertion locations/hashes and regenerates this matrix; it never infers results or runs upstream tools.\n\n",
  )
  markdown.write_string(
    "| Clause / fixed source | Normal | Static error | Runtime error | Lazy | Boundary | Remaining obligations |\n| --- | --- | --- | --- | --- | --- | --- |\n",
  )
  let enriched : Array[Json] = []
  let mut reviewed = 0
  let completed : Array[(String, Json)] = []
  let used : Map[String, Bool] = Map([])
  for item in rows {
    let id = text_field(item, "id")
    let row = field(item, "coverage")
    let ids = evidence_ids(row)
    let review = rule_review(row)
    let state = if review is Some(_) {
      "completed-rule-review"
    } else if ids.is_empty() {
      "unreviewed"
    } else {
      "manually-reviewed-subset"
    }
    if !ids.is_empty() && review is None {
      reviewed += 1
    }
    for evidence_id in ids {
      assert_true(
        evidence.contains(evidence_id),
        msg="unknown evidence ID " + evidence_id,
      )
      used[evidence_id] = true
    }
    let remaining = text_field(row, "remaining")
    if review is Some(record) {
      assert_eq(field(item, "kind"), "named-rule")
      assert_eq(text_field(record, "rule"), id)
      assert_eq(text_field(record, "decision"), "complete")
      let form = if record is Object(fields) {
        match fields.get("review_form") {
          None => "premise-free"
          Some(String(form)) => form
          _ => fail("review form must be a string")
        }
      } else {
        fail("review record")
      }
      if form == "premise-free" {
        assert_true(
          id.has_prefix("chk-") &&
          spec.split("\n").collect()[rule_lines[id]].trim() == "} {",
          msg="completion requires a premise-free static rule",
        )
      } else if form == "conditional-transfer" {
        // Only the explicitly reviewed conditional forms may use this record.
        // A source match is provenance validation, not a semantic proof.
        let statement = match id {
          "chk-if" =>
            "\\rule{chk-if} { Γ ⊢ e_1, e_2, e_3 } { Γ ⊢ \\if{e_1}{e_2}{e_3} }"
          "if-true" =>
            "\\rule{if-true} { e_1 ↓ \\true \\hspace{15pt} e_2 ↓ v } { \\if{e_1}{e_2}{e_3} ↓ v }"
          "if-false" =>
            "\\rule{if-false} { e_1 ↓ \\false \\hspace{15pt} e_3 ↓ v } { \\if{e_1}{e_2}{e_3} ↓ v }"
          _ => fail("conditional completion is restricted to reviewed forms")
        }
        let head = "\\rule{" + id + "} {"
        let parts = spec.split(head).collect()
        assert_eq(parts.length(), 2)
        let actual = head + parts[1].split("\\]").next().unwrap().to_owned()
        assert_eq(
          normalized(actual),
          statement,
          msg="fixed conditional source mismatch",
        )
        assert_eq(
          text_field(record, "fixed_statement"),
          statement,
          msg="reviewed conditional statement mismatch",
        )
        let roles : Json = match id {
          "chk-if" => ["condition", "then", "else"]
          "if-true" => ["condition-true", "then-value"]
          _ => ["condition-false", "else-value"]
        }
        assert_eq(
          field(record, "premise_roles"),
          roles,
          msg="conditional premise roles",
        )
        assert_true(!text_field(record, "child_judgments_assumed").is_empty())
        let required = if id == "chk-if" {
          ["static_error", "boundary"]
        } else {
          ["runtime_error", "lazy", "boundary"]
        }
        for name in required {
          assert_true(
            !dimension(row, name).is_empty(),
            msg="conditional evidence gap: " + name,
          )
        }
      } else {
        fail("unsupported explicit review form")
      }
      assert_true(!dimension(row, "normal").is_empty() && remaining.is_empty())
      assert_true(
        !text_field(record, "scope").is_empty() &&
        !text_field(record, "reasoning").is_empty(),
      )
      guard field(record, "remaining_in_rule") is Array(open) && open.is_empty() else {
        fail("in-rule obligations remain")
      }
      guard field(record, "excluded_obligations") is Array(excluded) &&
        !excluded.is_empty() else {
        fail("completion needs an explicit boundary")
      }
      ignore(@fs.read_file(text_field(record, "review_report")))
      guard field(record, "not_applicable") is Object(reasons) else {
        fail("N/A reasons")
      }
      if form == "premise-free" {
        assert_true(
          reasons.contains("static_error") && reasons.contains("runtime_error"),
        )
      } else if id == "chk-if" {
        assert_true(
          reasons.contains("runtime_error") && !reasons.contains("static_error"),
        )
      } else {
        assert_true(
          reasons.contains("static_error") && !reasons.contains("runtime_error"),
        )
      }
      for name, reason in reasons {
        guard reason is String(reason) && !reason.is_empty() else {
          fail("N/A reason")
        }
        assert_true(
          ["static_error", "runtime_error", "lazy", "boundary"].contains(name) &&
          dimension(row, name).is_empty(),
        )
      }
      guard field(record, "inspection") is Array(inspections) &&
        !inspections.is_empty() else {
        fail("constructor inspection required")
      }
      for inspection in inspections {
        let path = text_field(inspection, "file")
        assert_eq(
          sha256(path),
          text_field(inspection, "sha256"),
          msg="inspected implementation changed: " + path,
        )
        assert_true(
          @fs.read_file(path).text().contains(text_field(inspection, "anchor")),
        )
        assert_true(!text_field(inspection, "argument").is_empty())
      }
      guard field(record, "evidence_sha256") is Object(snapshot) &&
        !snapshot.is_empty() else {
        fail("reviewed test snapshot required")
      }
      for path, expected in snapshot {
        assert_eq(
          Json::string(sha256(path)),
          expected,
          msg="reviewed tests changed: " + path,
        )
      }
      completed.push((id, record))
    } else {
      assert_true(
        !remaining.is_empty(),
        msg="partial rows must state remaining obligations",
      )
    }
    guard field(row, "implementation") is Array(paths) else {
      fail("implementation pointers")
    }
    for path in paths {
      guard path is String(path) else { fail("implementation path") }
      ignore(@fs.read_file(path))
    }
    let dimensions : Map[String, Json] = Map([])
    for name in ["normal", "static_error", "runtime_error", "lazy", "boundary"] {
      dimensions[name] = Json::array(dimension(row, name))
    }
    let obligation : String? = if row is Object(fields) {
      match fields.get("obligation") {
        Some(String(text)) => Some(text)
        _ => None
      }
    } else {
      None
    }
    enriched.push({
      "id": id,
      "kind": field(item, "kind"),
      "section": field(item, "section"),
      "source_line": field(item, "source_line"),
      "state": state,
      "dimensions": dimensions,
      "remaining": remaining,
      "implementation": paths,
      "obligation": obligation,
      "rule_review": review,
    })
    markdown.write_string(
      "| [" +
      id +
      "](" +
      source_base +
      "#" +
      text_field(item, "section") +
      ")" +
      (if review is Some(_) {
        if id.has_prefix("chk-") {
          " **complete static rule**"
        } else {
          " **complete evaluation rule**"
        }
      } else {
        ""
      }) +
      " |",
    )
    for name in ["normal", "static_error", "runtime_error", "lazy", "boundary"] {
      markdown.write_string(" " + dimension_text(row, name) + " |")
    }
    markdown.write_string(
      " " +
      (if review is Some(_) {
        "None within this named judgment; see explicit exclusions and child assumptions below."
      } else {
        remaining
      }) +
      " |\n",
    )
  }
  assert_eq(used.length(), evidence.length(), msg="orphan evidence mappings")
  if !completed.is_empty() {
    markdown.write_string(
      "\n## Completed named-rule reviews\n\nThese are recorded manual decisions from constructor case analysis plus executed controls. The tool checks empty premises for premise-free judgments, or the exact fixed conditional statement and premise roles for the three reviewed conditional forms. It also checks inspected implementation/test hashes and explicit scope; source/name matches do not prove semantic correctness. Conditional transfer judgments assume their child judgments and do not complete other language rules or whole-language acceptance.\n\n",
    )
    for (id, record) in completed {
      let report = text_field(record, "review_report")
        .strip_prefix("docs/development/")
        .unwrap()
        .to_owned()
      markdown.write_string(
        "- **" +
        id +
        "**: " +
        text_field(record, "scope") +
        " " +
        text_field(record, "reasoning") +
        " [Criteria and exclusions](" +
        report +
        ").\n",
      )
    }
  }
  markdown.write_string(
    "\n## Assertion evidence\n\nEach description records what was checked in the assertion body; a declaration name or a textual anchor alone proves no semantic result. Shared evidence is counted once, regardless of how many clauses cite it. Implementation paths and individual dimensions are retained in [the machine-readable matrix](spec-language-matrix.json).\n\n",
  )
  markdown.write_string(
    "| ID | Exact test block | Reviewed assertion meaning |\n| --- | --- | --- |\n",
  )
  for id, item in locations {
    markdown.write_string(
      "| " +
      id +
      " | [" +
      text_field(item, "file") +
      "](../../" +
      text_field(item, "file") +
      "): `" +
      text_field(item, "test") +
      "` | " +
      text_field(item, "checks") +
      " |\n",
    )
  }
  markdown.write_string(
    "\nLexical UTF-8/tokenization, full grammar/precedence, unassigned chk-* rules, recursive comprehension/desugaring details and all unassigned operator rules remain open. The public standard-library inventory, eleven array observations, removeAt naming and Unicode surrogate ambiguity retain their existing status.\n",
  )
  let result : Json = {
    "spec_commit": pinned,
    "spec_sha256": spec_hash,
    "language_reference_sha256": language_hash,
    "mapping_sha256": sha256(mapping_path),
    "tool_sha256": sha256("tools/spec-language-matrix.mbtx"),
    "named_rules": rule_lines.length(),
    "prose_grammar_rows": clauses.length(),
    "manually_reviewed_subset_rows": reviewed,
    "completed_rule_rows": completed.length(),
    "completed_static_rule_rows": completed
    .filter(pair => pair.0.has_prefix("chk-"))
    .length(),
    "completed_evaluation_rule_rows": completed
    .filter(pair => !pair.0.has_prefix("chk-"))
    .length(),
    "unreviewed_rows": rows.length() - reviewed - completed.length(),
    "complete_conformance": false,
    "execution_inferred": false,
    "evidence": locations,
    "test_file_sha256": test_hashes,
    "clauses": enriched,
  }
  @fs.mkdir(output, recursive=true, allow_exist=true)
  let json = result.stringify(indent=2) + "\n"
  @fs.write_file(
    "docs/development/SPEC-LANGUAGE-MATRIX.md",
    markdown.to_string(),
  )
  @fs.write_file("docs/development/spec-language-matrix.json", json)
  @fs.write_file(output + "/matrix.json", json)
  @fs.write_file(
    output + "/validation.json",
    Json::object(
      Map([
        ("source_head", Json::string(checked("git", ["rev-parse", "HEAD"]))),
        (
          "tracked_diff",
          Json::string(checked("git", ["diff", "HEAD", "--stat"])),
        ),
        (
          "matrix_sha256",
          Json::string(sha256("docs/development/spec-language-matrix.json")),
        ),
        (
          "markdown_sha256",
          Json::string(sha256("docs/development/SPEC-LANGUAGE-MATRIX.md")),
        ),
      ]),
    ).stringify(indent=2) +
    "\n",
  )
  println(
    "Enumerated \{rule_lines.length()} named rules and \{clauses.length()} prose/grammar rows; \{completed.length()} completed named-rule reviews, \{reviewed} partial rows, \{rows.length() - reviewed - completed.length()} unreviewed rows. No execution or whole-language acceptance inferred.",
  )
}
