///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn checked(program : String, args : Array[String]) -> String {
  let result = @shell.Cmd(program, args).output(timeout_ms=10000)
  result.check()
  result.stdout().trim().to_owned()
}

///|
async fn sha256(path : String) -> String {
  checked("shasum", ["-a", "256", path]).split(" ").next().unwrap().to_owned()
}

///|
fn field(value : Json, key : String) -> Json {
  guard value is Object(fields) else { abort("object required") }
  fields.get(key).unwrap()
}

///|
fn text_field(value : Json, key : String) -> String {
  guard field(value, key) is String(text) else {
    abort("string required: " + key)
  }
  text
}

///|
fn normalized(text : String) -> String {
  let out = StringBuilder()
  let mut space = false
  for c in text {
    if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
      space = true
    } else {
      if space {
        out.write_char(' ')
      }
      space = false
      out.write_char(c)
    }
  }
  out.to_string()
}

///|
fn mapping_space(source : String, start : Int) -> Int {
  let mut pos = start
  while pos < source.length() {
    match source.code_unit_at(pos) {
      32 | 9 | 10 | 13 => pos += 1
      _ => break
    }
  }
  pos
}

///|
fn mapping_string_end(source : String, start : Int) -> Int raise {
  let mut pos = start + 1
  while pos < source.length() {
    match source.code_unit_at(pos) {
      34 => return pos + 1
      92 => pos += 2
      _ => pos += 1
    }
  }
  fail("unterminated mapping string")
}

///|
// Run after syntax parsing, but before using the parsed Map: core/json drops
// earlier duplicate members. Decode raw keys so escaped spellings also collide.
fn mapping_value_end(source : String, start : Int, path : String) -> Int raise {
  let mut pos = mapping_space(source, start)
  match source.code_unit_at(pos) {
    123 => {
      let seen : Map[String, Bool] = Map([])
      pos = mapping_space(source, pos + 1)
      if source.code_unit_at(pos) == 125 {
        return pos + 1
      }
      while pos < source.length() {
        let end = mapping_string_end(source, pos)
        guard @json.parse(source[pos:end]) is String(key) else {
          fail("mapping object key must be String")
        }
        assert_true(
          !seen.contains(key),
          msg="duplicate mapping key: " + path + "." + key,
        )
        seen[key] = true
        pos = mapping_space(source, end)
        assert_eq(source.code_unit_at(pos), 58)
        pos = mapping_space(
          source,
          mapping_value_end(source, pos + 1, path + "." + key),
        )
        if source.code_unit_at(pos) == 125 {
          return pos + 1
        }
        assert_eq(source.code_unit_at(pos), 44)
        pos = mapping_space(source, pos + 1)
      }
      fail("unterminated mapping object")
    }
    91 => {
      pos = mapping_space(source, pos + 1)
      if source.code_unit_at(pos) == 93 {
        return pos + 1
      }
      let mut index = 0
      while pos < source.length() {
        pos = mapping_space(
          source,
          mapping_value_end(source, pos, path + "[" + index.to_string() + "]"),
        )
        if source.code_unit_at(pos) == 93 {
          return pos + 1
        }
        assert_eq(source.code_unit_at(pos), 44)
        pos = mapping_space(source, pos + 1)
        index += 1
      }
      fail("unterminated mapping array")
    }
    34 => mapping_string_end(source, pos)
    _ => {
      while pos < source.length() {
        match source.code_unit_at(pos) {
          32 | 9 | 10 | 13 | 44 | 93 | 125 => break
          _ => pos += 1
        }
      }
      pos
    }
  }
}

///|
fn dimension(row : Json, name : String) -> Array[Json] {
  guard row is Object(fields) else { abort("coverage row") }
  match fields.get(name) {
    None => []
    Some(Array(values)) => values
    _ => abort("dimension must be an evidence array: " + name)
  }
}

///|
fn evidence_ids(row : Json) -> Array[String] {
  let ids : Array[String] = []
  for name in ["normal", "static_error", "runtime_error", "lazy", "boundary"] {
    for value in dimension(row, name) {
      guard value is String(id) else { abort("evidence ID must be string") }
      if !ids.contains(id) {
        ids.push(id)
      }
    }
  }
  ids
}

///|
fn rule_review(row : Json) -> Json? {
  guard row is Object(fields) else { abort("coverage row") }
  fields.get("rule_review")
}

///|
fn assertion_transfer_statements() -> Array[String] {
  [
    "desugar_{expr}(\\assert e ; e', b) = desugar_{expr}(\\assert e : \\texttt{\"Assertion failed\"} ; e', b)",
    "desugar_{expr}(\\assert e : e' ; e'', b) = desugar_{expr}(\\if {e} {e''} {\\error{e'}}, b)",
    "desugar_{assert}(\\assert e, binds) = desugar_{assert}(\\assert e : \\texttt{\"Assertion failed\"}, binds)",
    "desugar_{assert}(\\assert e : e', binds) = \\assert{desugar_{expr}(\\local{binds}{\\if{e}{\\null}{\\error{e'}}}, \\true)}",
  ]
}

///|
fn dimension_text(row : Json, name : String) -> String {
  let ids = dimension(row, name).map(value => {
    match value {
      String(id) => "[" + id + "](#assertion-evidence)"
      _ => abort("evidence ID")
    }
  })
  if ids.is_empty() {
    if rule_review(row) is Some(review) &&
      field(review, "not_applicable") is Object(reasons) &&
      reasons.contains(name) {
      "N/A (named rule)"
    } else {
      "unreviewed"
    }
  } else {
    ids.join(", ")
  }
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    fail(
      "Usage: moon run --frozen tools/spec-language-matrix.mbtx REFERENCE_DIR EVIDENCE_DIR",
    )
  }
  let pinned = "bbb38f1020be1f5aed560928fb839b2c448cefb4"
  let reference = args[1]
  let output = args[2]
  let spec_hash = "bbac3701ef0316fc29de6c543049ae8f0f78c876bdd94fbf6ab845b2023a720a"
  let language_hash = "c55666af13894c8100c84fb053e647cd0ca516f3bb554d0ced29dfa83c3772be"
  assert_eq(sha256(reference + "/spec.html"), spec_hash)
  assert_eq(sha256(reference + "/language.md"), language_hash)
  let spec = @fs.read_file(reference + "/spec.html").text()
  let mapping_path = "tests/spec-language-coverage.json"
  let mapping_source = @fs.read_file(mapping_path).text()
  let mapping = @json.parse(mapping_source)
  assert_eq(
    mapping_space(mapping_source, mapping_value_end(mapping_source, 0, "$")),
    mapping_source.length(),
    msg="mapping JSON scan incomplete",
  )
  assert_eq(
    field(mapping, "version"),
    Json::number(2),
    msg="mapping schema v2 required",
  )
  assert_eq(text_field(mapping, "spec_commit"), pinned)
  guard field(mapping, "evidence") is Object(evidence) else {
    fail("evidence table")
  }
  guard field(mapping, "rules") is Object(mapped_rules) else {
    fail("rule table")
  }
  guard field(mapping, "clauses") is Array(clauses) else {
    fail("clause table")
  }
  let test_hashes : Map[String, Json] = Map([])
  let locations : Map[String, Json] = Map([])
  let test_ids : Map[String, String] = Map([])
  for id, item in evidence {
    let path = text_field(item, "file")
    let case_name = text_field(item, "test")
    guard item is Object(properties) &&
      properties.get("test_id") is Some(String(test_id)) &&
      !test_id.is_empty() else {
      fail("global test ID required: " + id)
    }
    for part in path.split("/") {
      assert_true(
        !part.is_empty() && part != "." && part != "..",
        msg="canonical relative test path required: " + id,
      )
    }
    assert_eq(
      test_id,
      path + "::" + case_name,
      msg="evidence test ID/file/case mismatch: " + id,
    )
    assert_true(
      !test_ids.contains(test_id),
      msg="duplicate global test ID: " + test_id,
    )
    test_ids[test_id] = id
    let source = @fs.read_file(path).text()
    test_hashes[path] = Json::string(sha256(path))
    let declaration = "test \"" + case_name + "\" {"
    let fragments = source.split(declaration).collect()
    assert_eq(fragments.length(), 2, msg="unique test declaration for " + id)
    let block = normalized(
      fragments[1].split("\n///|").next().unwrap().to_owned(),
    )
    guard field(item, "assertions") is Array(assertions) else {
      fail("assertion list")
    }
    assert_true(
      !assertions.is_empty(),
      msg="explicit assertion anchors for " + id,
    )
    assert_true(
      !text_field(item, "checks").is_empty(),
      msg="manual semantic explanation for " + id,
    )
    for value in assertions {
      guard value is String(assertion) else { fail("assertion text") }
      assert_true(
        block.contains(normalized(assertion)),
        msg="assertion anchor changed: " + id + ": " + assertion,
      )
    }
    let line = fragments[0].split("\n").count()
    locations[id] = {
      "file": path,
      "line": line,
      "test": case_name,
      "test_id": test_id,
      "assertions": assertions,
      "checks": text_field(item, "checks"),
      "status": "manually reviewed assertion subset; execution is separate",
    }
  }
  let rule_lines : Map[String, Int] = Map([])
  let sections : Map[String, Int] = Map([])
  for i, line in spec.split("\n").collect() {
    if line.contains("<h") && line.contains(" id=\"") {
      let anchor = line.split(" id=\"").collect()[1]
        .split("\"")
        .next()
        .unwrap()
        .to_owned()
      sections[anchor] = i + 1
    }
    if line.contains("\\rule{") {
      let rule = line.split("\\rule{").collect()[1]
        .split("}")
        .next()
        .unwrap()
        .to_owned()
      assert_true(
        !rule_lines.contains(rule),
        msg="duplicate source rule " + rule,
      )
      rule_lines[rule] = i + 1
    }
  }
  assert_eq(rule_lines.length(), 70, msg="pinned named-rule inventory")
  for name, _ in mapped_rules {
    assert_true(
      rule_lines.contains(name),
      msg="mapping names an absent rule: " + name,
    )
  }
  let rows : Array[Json] = []
  for name, line in rule_lines {
    let section = if name.has_prefix("chk-") {
      "static_checking"
    } else if name.has_prefix("manifest-") {
      "manifestation"
    } else {
      "execution"
    }
    let row = mapped_rules
      .get(name)
      .unwrap_or({
        "remaining": "No manually reviewed assertions assigned. Normal, static/runtime errors, lazy and boundary obligations remain unreviewed.",
        "implementation": [],
      })
    rows.push({
      "id": name,
      "section": section,
      "source_line": line,
      "kind": "named-rule",
      "coverage": row,
    })
  }
  let clause_ids : Map[String, Bool] = Map([])
  for clause in clauses {
    let id = text_field(clause, "id")
    let section = text_field(clause, "section")
    assert_true(
      sections.contains(section),
      msg="unknown source anchor " + section,
    )
    assert_true(!clause_ids.contains(id), msg="duplicate clause " + id)
    clause_ids[id] = true
    rows.push({
      "id": id,
      "section": section,
      "source_line": sections[section],
      "kind": "prose-or-grammar-obligation",
      "coverage": clause,
    })
  }
  let source_base = "https://github.com/google/jsonnet/blob/" +
    pinned +
    "/doc/ref/spec.html"
  let markdown = StringBuilder()
  markdown.write_string("# Language clause matrix\n\n")
  markdown.write_string(
    "Generated by [spec-language-matrix.mbtx](../../tools/spec-language-matrix.mbtx) from [manual assertion mappings](../../tests/spec-language-coverage.json). ",
  )
  markdown.write_string(
    "Fixed [specification](" +
    source_base +
    ") and [language reference](https://github.com/google/jsonnet/blob/" +
    pinned +
    "/doc/ref/language.html.md).\n\n",
  )
  markdown.write_string(
    "All 70 named inference rules are enumerated, including specification builtins. The additional prose/grammar rows are an initial obligation inventory, not a claim that every prose/desugaring clause has been decomposed. ",
  )
  markdown.write_string(
    "Populated cells identify manually examined assertions. Empty cells remain unreviewed. Completed named-rule reviews concern only their named judgments; completed prose constructor transfers are counted separately and assume their children. N/A cells have stated in-scope reasons, not missing passing tests. Runtime errors include host Type/Assertion categories after successful parsing. ",
  )
  markdown.write_string(
    "Independent outcomes are in [the initial language report](SPEC-LANGUAGE-EVIDENCE-2026-10-22.md), [recursive binding/comprehension report](SPEC-LANGUAGE-FORMS-EVIDENCE-2026-10-22.md), [application entry-path report](SPEC-LANGUAGE-CALL-EVIDENCE-2026-10-22.md), [static importstr report](SPEC-IMPORTSTR-STATIC-EVIDENCE-2026-10-22.md), [binary byte-substitution report](SPEC-IMPORTBIN-BYTES-EVIDENCE-2026-10-22.md), [UTF-8 text-substitution report](SPEC-IMPORTSTR-UTF8-EVIDENCE-2026-10-22.md), [conditional-rule report](SPEC-CONDITIONAL-EVIDENCE-2026-10-22.md), [static error report](SPEC-ERROR-STATIC-EVIDENCE-2026-10-22.md), [static unary report](SPEC-UNARY-STATIC-EVIDENCE-2026-10-22.md), [inherited-function receiver report](SPEC-INHERITED-SELF-EVIDENCE-2026-10-22.md), [super-prefix report](SPEC-SUPER-PREFIX-EVIDENCE-2026-10-22.md), [lexical-root report](SPEC-ROOT-SCOPE-EVIDENCE-2026-10-22.md), [assertion-self closure report](SPEC-ASSERTION-SELF-EVIDENCE-2026-10-22.md), [assertion-super report](SPEC-ASSERTION-SUPER-EVIDENCE-2026-10-22.md), [assertion object-local report](SPEC-ASSERTION-LOCAL-EVIDENCE-2026-10-22.md), [assertion conjunction/constructor report](SPEC-ASSERTION-CONJUNCTION-EVIDENCE-2026-10-22.md), [object-assertion adjudication](SPEC-OBJECT-ASSERTION-ADJUDICATION-2026-10-22.md), [object-comprehension key report](SPEC-OBJECT-COMP-KEYS-EVIDENCE-2026-10-22.md), [array-ordering report](SPEC-ARRAY-ORDERING-EVIDENCE-2026-10-22.md), [Boolean operator report](SPEC-BOOLEAN-SHORTCIRCUIT-EVIDENCE-2026-10-22.md), [imported closure report](SPEC-IMPORT-CLOSURE-EVIDENCE-2026-10-22.md), [combined sequence record](SPEC-SEQUENCE-STRUCTURE-2026-10-22.md), [number-token record](SPEC-NUMBER-TOKENS-2026-10-22.md), [precedence record](SPEC-PRECEDENCE-2026-10-22.md), [object reflection Ex record](SPEC-OBJECT-REFLECTION-EX-2026-10-22.md), [primitive equality record](SPEC-PRIMITIVE-EQUALS-2026-10-22.md), [makeArray/PE0 record](SPEC-MAKEARRAY-2026-10-22.md), [filter record](SPEC-FILTER-2026-10-22.md), [Object head/count record](SPEC-OBJECT-HEAD-2026-10-22.md), [string-concat record](SPEC-STRING-CONCAT-2026-10-22.md), [identifier record](SPEC-LEX-NAMES-2026-10-23.md), [operator-token record](SPEC-OPERATOR-TOKENS-2026-10-23.md), [relational sign record](SPEC-RELATIONAL-SIGN-2026-10-23.md) and [strict negation record](SPEC-NEGATION-2026-10-23.md); [Go/C++ comparison](SPEC-LANGUAGE-COMPARISON-2026-10-22.md) is separate. Whole-language conformance remains incomplete.\n\n",
  )
  markdown.write_string(
    "Reproduce with `moon run --frozen tools/spec-language-matrix.mbtx REFERENCE_DIR EVIDENCE_DIR`; REFERENCE_DIR supplies pinned spec.html/language.md and, for Object head/count reviews, stdlib.html. This command validates assertion locations/hashes and regenerates this matrix; it never infers results or runs upstream tools.\n\n",
  )
  markdown.write_string(
    "| Clause / fixed source | Normal | Static error | Runtime error | Lazy | Boundary | Remaining obligations |\n| --- | --- | --- | --- | --- | --- | --- |\n",
  )
  let enriched : Array[Json] = []
  let mut reviewed = 0
  let completed : Array[(String, Json)] = []
  let completed_constructors : Array[(String, Json)] = []
  let used : Map[String, Bool] = Map([])
  for item in rows {
    let id = text_field(item, "id")
    let row = field(item, "coverage")
    let ids = evidence_ids(row)
    let review = rule_review(row)
    let state = if review is Some(_) {
      if text_field(item, "kind") == "prose-or-grammar-obligation" {
        "completed-constructor-review"
      } else {
        "completed-rule-review"
      }
    } else if ids.is_empty() {
      "unreviewed"
    } else {
      "manually-reviewed-subset"
    }
    if !ids.is_empty() && review is None {
      reviewed += 1
    }
    for evidence_id in ids {
      assert_true(
        evidence.contains(evidence_id),
        msg="unknown evidence ID " + evidence_id,
      )
      used[evidence_id] = true
    }
    let remaining = text_field(row, "remaining")
    if review is Some(record) {
      assert_eq(text_field(record, "rule"), id)
      assert_eq(text_field(record, "decision"), "complete")
      let form = if record is Object(fields) {
        match fields.get("review_form") {
          None => "premise-free"
          Some(String(form)) => form
          _ => fail("review form must be a string")
        }
      } else {
        fail("review record")
      }
      if form == "assertion-constructor-transfer" {
        assert_eq(
          id,
          "DESUGAR-ASSERT",
          msg="assertion constructor completion is restricted to DESUGAR-ASSERT",
        )
        assert_eq(field(item, "kind"), "prose-or-grammar-obligation")
      } else {
        assert_eq(field(item, "kind"), "named-rule")
      }
      if form == "premise-free" {
        assert_true(
          id.has_prefix("chk-") &&
          spec.split("\n").collect()[rule_lines[id]].trim() == "} {",
          msg="completion requires a premise-free static rule",
        )
      } else if form == "conditional-transfer" ||
        form == "pair-static-transfer" ||
        form == "value-head-transfer" {
        // These bounded aliases reuse the existing statement/role checks.
        // A source match is provenance validation, not a semantic proof.
        if form == "value-head-transfer" {
          assert_eq(
            id,
            "value",
            msg="value head completion restricted to value",
          )
        } else if form == "pair-static-transfer" {
          assert_true(
            ["chk-array-index", "chk-binary"].contains(id),
            msg="static pair completion restricted to index and binary",
          )
        } else {
          assert_true(
            ["chk-if", "if-true", "if-false"].contains(id),
            msg="conditional completion is restricted to reviewed forms",
          )
        }
        let statement = match id {
          "value" =>
            "\\rule{value} { v ∈ \\{\\null, \\true, \\false\\} ∪ String ∪ Number ∪ Function ∪ Array } { v ↓ v }"
          "chk-array-index" =>
            "\\rule{chk-array-index} { Γ ⊢ e \\\\ Γ ⊢ e' } { Γ ⊢ e[e'] }"
          "chk-binary" =>
            "\\rule{chk-binary} { Γ ⊢ e_L, e_R } { Γ ⊢ \\binary{e_L}{sym}{e_R} }"
          "chk-if" =>
            "\\rule{chk-if} { Γ ⊢ e_1, e_2, e_3 } { Γ ⊢ \\if{e_1}{e_2}{e_3} }"
          "if-true" =>
            "\\rule{if-true} { e_1 ↓ \\true \\hspace{15pt} e_2 ↓ v } { \\if{e_1}{e_2}{e_3} ↓ v }"
          "if-false" =>
            "\\rule{if-false} { e_1 ↓ \\false \\hspace{15pt} e_3 ↓ v } { \\if{e_1}{e_2}{e_3} ↓ v }"
          _ => fail("conditional completion is restricted to reviewed forms")
        }
        let head = "\\rule{" + id + "} {"
        let parts = spec.split(head).collect()
        assert_eq(parts.length(), 2)
        let actual = head + parts[1].split("\\]").next().unwrap().to_owned()
        assert_eq(
          normalized(actual),
          statement,
          msg="fixed transfer source mismatch",
        )
        assert_eq(
          text_field(record, "fixed_statement"),
          statement,
          msg="reviewed transfer statement mismatch",
        )
        let roles : Json = match id {
          "value" => ["domain-member"]
          "chk-array-index" => ["target", "index"]
          "chk-binary" => ["left", "right"]
          "chk-if" => ["condition", "then", "else"]
          "if-true" => ["condition-true", "then-value"]
          _ => ["condition-false", "else-value"]
        }
        assert_eq(
          field(record, "premise_roles"),
          roles,
          msg="transfer premise roles",
        )
        assert_true(
          !text_field(record, "child_judgments_assumed").is_empty(),
          msg="transfer child assumptions required",
        )
        let required = if form == "value-head-transfer" {
          ["lazy", "boundary"]
        } else if form == "pair-static-transfer" {
          ["static_error", "lazy", "boundary"]
        } else if id == "chk-if" {
          ["static_error", "boundary"]
        } else {
          ["runtime_error", "lazy", "boundary"]
        }
        for name in required {
          assert_true(
            !dimension(row, name).is_empty(),
            msg="transfer evidence gap: " + name,
          )
        }
      } else if form == "boolean-shortcut-transfer" {
        // Only the two explicit one-premise shortcuts are adjudicated here.
        // Longcut's non-Boolean RHS domain is deliberately not inferred.
        let (statement, roles) : (String, Json) = match id {
          "boolean-and-shortcut" =>
            (
              "\\rule{boolean-and-shortcut} { e_L ↓ \\false } { e_L \\texttt{ &amp;&amp; } e_R ↓ \\false }",
              ["left-false"],
            )
          "boolean-or-shortcut" =>
            (
              "\\rule{boolean-or-shortcut} { e_L ↓ \\true } { e_L \\texttt{ || } e_R ↓ \\true }",
              ["left-true"],
            )
          _ =>
            fail(
              "Boolean shortcut completion is restricted to two reviewed rules",
            )
        }
        let head = "\\rule{" + id + "} {"
        let parts = spec.split(head).collect()
        assert_eq(parts.length(), 2)
        let actual = head + parts[1].split("\\]").next().unwrap().to_owned()
        assert_eq(
          normalized(actual),
          statement,
          msg="fixed Boolean shortcut source mismatch",
        )
        assert_eq(
          text_field(record, "fixed_statement"),
          statement,
          msg="reviewed Boolean shortcut statement mismatch",
        )
        assert_eq(
          field(record, "premise_roles"),
          roles,
          msg="Boolean shortcut premise role",
        )
        assert_true(
          !text_field(record, "child_judgments_assumed").is_empty(),
          msg="Boolean shortcut child assumptions required",
        )
        guard field(record, "excluded_obligations") is Array(excluded) else {
          fail("Boolean shortcut exclusions required")
        }
        assert_true(
          excluded.contains("Longcut non-Boolean RHS domain (B0)"),
          msg="Boolean shortcut must exclude B0",
        )
        for name in ["runtime_error", "lazy", "boundary"] {
          assert_true(
            !dimension(row, name).is_empty(),
            msg="Boolean shortcut evidence gap: " + name,
          )
        }
      } else if form == "boolean-negation-transfer" {
        let (statement, operand, result) : (String, Json, Json) = match id {
          "not-true" =>
            (
              "\\rule{not-true} { e ↓ \\true } { \\texttt{!} e ↓ \\false }",
              Json::boolean(true),
              Json::boolean(false),
            )
          "not-false" =>
            (
              "\\rule{not-false} { e ↓ \\false } { \\texttt{!} e ↓ \\true }",
              Json::boolean(false),
              Json::boolean(true),
            )
          _ =>
            fail("Boolean negation completion restricted to two reviewed rules")
        }
        let head = "\\rule{" + id + "} {"
        let parts = spec.split(head).collect()
        assert_eq(parts.length(), 2)
        let actual = head + parts[1].split("\\]").next().unwrap().to_owned()
        assert_eq(
          normalized(actual),
          statement,
          msg="fixed Boolean negation source mismatch",
        )
        assert_eq(
          text_field(record, "fixed_statement"),
          statement,
          msg="reviewed Boolean negation statement mismatch",
        )
        assert_eq(
          text_field(record, "operator"),
          "!",
          msg="Boolean negation operator",
        )
        assert_eq(
          field(record, "operand_domains"),
          Json::array(["Boolean"]),
          msg="Boolean negation domain",
        )
        assert_eq(
          field(record, "operand_value"),
          operand,
          msg="Boolean negation operand",
        )
        assert_eq(
          field(record, "result"),
          result,
          msg="Boolean negation result",
        )
        assert_eq(
          text_field(record, "demand_policy"),
          "operand-head-only",
          msg="Boolean negation demand policy",
        )
        assert_true(
          !text_field(record, "child_judgments_assumed").is_empty(),
          msg="Boolean negation child assumptions required",
        )
        guard field(record, "excluded_obligations") is Array(excluded) else {
          fail("Boolean negation exclusions required")
        }
        for
          exclusion in [
            "Whole operand/static/grammar judgments and other unary operators.",
            "Object/array/function producers, inheritance/assertion and public native contracts.",
            "A0/B0/N0/R0/PE0, greater-than print conflict, malformed block, encoding/rounding/resources and Go-C++ acceptance.",
          ] {
          assert_true(
            excluded.contains(Json::string(exclusion)),
            msg="Boolean negation must exclude " + exclusion,
          )
        }
        for name in ["runtime_error", "lazy", "boundary"] {
          assert_true(
            !dimension(row, name).is_empty(),
            msg="Boolean negation evidence gap: " + name,
          )
        }
      } else if form == "comparison-sign-transfer" {
        let (statement, symbol, signs, result) : (String, String, Json, Json) = match
          id {
          "less-than-true" =>
            (
              "\\rule{less-than-true} { \\texttt{std.cmp}(e_L, e_R) ↓ -1 } { e_L &lt; e_R ↓ \\texttt{true} }",
              "<",
              Json::array([Json::number(-1)]),
              Json::boolean(true),
            )
          "less-than-false" =>
            (
              "\\rule{less-than-false} { \\texttt{std.cmp}(e_L, e_R) ↓ r \\\\ r ∈ \\{0, 1\\} } { e_L &lt; e_R ↓ \\texttt{false} }",
              "<",
              Json::array([Json::number(0), Json::number(1)]),
              Json::boolean(false),
            )
          "less-or-equal-true" =>
            (
              "\\rule{less-or-equal-true} { \\texttt{std.cmp}(e_L, e_R) ↓ r \\\\ r ∈ \\{-1, 0\\} } { e_L &lt;= e_R ↓ \\texttt{true} }",
              "<=",
              Json::array([Json::number(-1), Json::number(0)]),
              Json::boolean(true),
            )
          "less-or-equal-false" =>
            (
              "\\rule{less-or-equal-false} { \\texttt{std.cmp}(e_L, e_R) ↓ 1 } { e_L &lt;= e_R ↓ \\texttt{false} }",
              "<=",
              Json::array([Json::number(1)]),
              Json::boolean(false),
            )
          "greater-or-equal-true" =>
            (
              "\\rule{greater-or-equal-true} { \\texttt{std.cmp}(e_L, e_R) ↓ r \\\\ r ∈ \\{0, 1\\} } { e_L &gt;= e_R ↓ \\texttt{true} }",
              ">=",
              Json::array([Json::number(0), Json::number(1)]),
              Json::boolean(true),
            )
          "greater-or-equal-false" =>
            (
              "\\rule{greater-or-equal-false} { \\texttt{std.cmp}(e_L, e_R) ↓ -1 } { e_L &gt;= e_R ↓ \\texttt{false} }",
              ">=",
              Json::array([Json::number(-1)]),
              Json::boolean(false),
            )
          _ =>
            fail("comparison-sign completion restricted to six reviewed rules")
        }
        let head = "\\rule{" + id + "} {"
        let parts = spec.split(head).collect()
        assert_eq(parts.length(), 2)
        let actual = head + parts[1].split("\\]").next().unwrap().to_owned()
        assert_eq(
          normalized(actual),
          statement,
          msg="fixed comparison-sign source mismatch",
        )
        assert_eq(
          text_field(record, "fixed_statement"),
          statement,
          msg="reviewed comparison-sign statement mismatch",
        )
        assert_eq(
          text_field(record, "operator"),
          symbol,
          msg="comparison-sign operator",
        )
        assert_eq(
          field(record, "comparison_domain"),
          Json::array([Json::number(-1), Json::number(0), Json::number(1)]),
          msg="comparison-sign domain",
        )
        assert_eq(
          field(record, "accepted_signs"),
          signs,
          msg="comparison-sign accepted signs",
        )
        assert_eq(field(record, "result"), result, msg="comparison-sign result")
        assert_eq(
          field(record, "operand_roles"),
          Json::array(["left", "right"]),
          msg="comparison-sign operand order",
        )
        assert_true(
          !text_field(record, "child_judgments_assumed").is_empty(),
          msg="comparison-sign child assumptions required",
        )
        guard field(record, "excluded_obligations") is Array(excluded) else {
          fail("comparison-sign exclusions required")
        }
        for
          exclusion in [
            "Whole operand, comparator, scalar/array and static judgments; arbitrary producers.",
            "Public std.cmp registration, std rebinding, greater-than rules and other operators.",
            "A0/B0/N0/R0/PE0, malformed block lexing, encoding/rounding/resources and Go-C++ acceptance.",
          ] {
          assert_true(
            excluded.contains(Json::string(exclusion)),
            msg="comparison-sign must exclude " + exclusion,
          )
        }
        for name in ["runtime_error", "lazy", "boundary"] {
          assert_true(
            !dimension(row, name).is_empty(),
            msg="comparison-sign evidence gap: " + name,
          )
        }
      } else if form == "sequence-length-transfer" {
        let (statement, roles, unit) : (String, Json, String) = match id {
          "length-array" =>
            (
              "\\rule{length-array} { e ↓ \\array{e_0 \\ldots e_{n - 1}} } { \\texttt{std.length}(e) ↓ n }",
              ["array-value"],
              "elements",
            )
          "length-string" =>
            (
              "\\rule{length-string} { e ↓ v ∈ String } { \\texttt{std.length}(e) ↓ strlen(v) }",
              ["string-value"],
              "Unicode-codepoints",
            )
          _ =>
            fail(
              "sequence length completion is restricted to two reviewed rules",
            )
        }
        let head = "\\rule{" + id + "} {"
        let parts = spec.split(head).collect()
        assert_eq(parts.length(), 2)
        let actual = head + parts[1].split("\\]").next().unwrap().to_owned()
        assert_eq(
          normalized(actual),
          statement,
          msg="fixed sequence length source mismatch",
        )
        assert_eq(
          text_field(record, "fixed_statement"),
          statement,
          msg="reviewed sequence length statement mismatch",
        )
        assert_eq(
          field(record, "premise_roles"),
          roles,
          msg="sequence length premise role",
        )
        assert_eq(
          text_field(record, "length_unit"),
          unit,
          msg="sequence length unit",
        )
        assert_true(spec.contains("unicode characters in the string."))
        assert_true(
          !text_field(record, "child_judgments_assumed").is_empty(),
          msg="sequence length child assumptions required",
        )
        guard field(record, "excluded_obligations") is Array(excluded) else {
          fail("sequence length exclusions required")
        }
        assert_true(
          excluded.contains("Array-concat formal index mismatch (A0)"),
          msg="sequence length must exclude A0",
        )
        for name in ["runtime_error", "lazy", "boundary"] {
          assert_true(
            !dimension(row, name).is_empty(),
            msg="sequence length evidence gap: " + name,
          )
        }
      } else if form == "object-head-transfer" {
        let (statement, interpreted, roles, result, dependencies) : (
          String,
          String,
          Json,
          String,
          Array[String],
        ) = match id {
          "length-object" =>
            (
              "\\rule{length-object} { \\texttt{std.length}(\\texttt{std.objectFieldsEx}(e, false) ↓ n } { \\texttt{std.length}(e) ↓ n }",
              "\\rule{length-object} { \\texttt{std.length}(\\texttt{std.objectFieldsEx}(e, false)) ↓ n } { \\texttt{std.length}(e) ↓ n }",
              ["visible-name-array-count"],
              "visible-field-count",
              ["object-fields-ex", "length-array"],
            )
          "type-object" => {
            let statement = "\\rule{type-object} { e ↓ v ∈ Object } { \\texttt{std.type}(e) ↓ \\texttt{\"object\"} }"
            (
              statement,
              statement,
              ["evaluated-object"],
              "literal-object-tag",
              [],
            )
          }
          _ =>
            fail(
              "object-head completion is restricted to length-object/type-object",
            )
        }
        let head = "\\rule{" + id + "} {"
        let parts = spec.split(head).collect()
        assert_eq(parts.length(), 2)
        let actual = head + parts[1].split("\\]").next().unwrap().to_owned()
        assert_eq(
          normalized(actual),
          statement,
          msg="fixed object-head source mismatch",
        )
        assert_eq(
          text_field(record, "fixed_statement"),
          statement,
          msg="reviewed object-head statement mismatch",
        )
        assert_eq(
          text_field(record, "interpreted_statement"),
          interpreted,
          msg="object-head interpretation mismatch",
        )
        assert_eq(
          field(record, "premise_roles"),
          roles,
          msg="object-head premise roles",
        )
        assert_eq(
          field(record, "argument_domains"),
          Json::array(["Object"]),
          msg="object-head argument domain",
        )
        assert_eq(
          text_field(record, "result_contract"),
          result,
          msg="object-head result contract",
        )
        assert_eq(
          text_field(record, "demand_policy"),
          "object-head-only",
          msg="object-head demand policy",
        )
        assert_eq(
          field(record, "dependency_rules"),
          Json::array(dependencies.map(d => Json::string(d))),
          msg="object-head dependencies",
        )
        for dependency in dependencies {
          guard mapped_rules.get(dependency) is Some(row) &&
            rule_review(row) is Some(review) else {
            fail("object-head dependency review required: " + dependency)
          }
          assert_eq(
            text_field(review, "decision"),
            "complete",
            msg="object-head dependency not complete",
          )
        }
        assert_eq(
          sha256(reference + "/stdlib.html"),
          "0eb80c0ccaf781c4c2c1bc06a22d2d6e57f9866f41c0b62431b5ca4f510e6853",
          msg="fixed object-head public source mismatch",
        )
        assert_true(
          @fs.read_file(reference + "/stdlib.html")
          .text()
          .contains("number of fields in the object."),
        )
        assert_true(
          !text_field(record, "child_judgments_assumed").is_empty(),
          msg="object-head child assumptions required",
        )
        guard field(record, "excluded_obligations") is Array(excluded) else {
          fail("object-head exclusions required")
        }
        for
          exclusion in [
            "Whole object construction/inheritance and N0/R0 assertion judgments.",
            "Other length/type overloads, invocation/std rebinding and value producers.",
            "A0/B0/PE0, encoding/rounding/resource and Go-C++ acceptance.",
          ] {
          assert_true(
            excluded.contains(Json::string(exclusion)),
            msg="object-head must exclude " + exclusion,
          )
        }
        for name in ["runtime_error", "lazy", "boundary"] {
          assert_true(
            !dimension(row, name).is_empty(),
            msg="object-head evidence gap: " + name,
          )
        }
      } else if form == "object-reflection-transfer" {
        let (statement, domains, contract) : (String, Json, String) = match id {
          "object-has-ex" =>
            (
              "\\rule{object-has-ex} { e' ↓ f \\\\ e'' ↓ b' \\\\ e ↓ \\object{\\assert{e'_1} \\ldots \\assert{e'_m}, f_1 h_1 e_1 \\ldots f_n h_n e_n } \\\\ b = ∃i: f = f_i ∧ (h_i \\mathop{≠} :: \\mathop{∨} b') } { \\texttt{std.objectHasEx}(e, e', e'') ↓ b }",
              ["Object", "String", "Boolean"],
              "membership-without-field-demand",
            )
          "object-fields-ex" =>
            (
              "\\rule{object-fields-ex} { e' ↓ b' \\\\ e ↓ \\object{\\assert{e'_1} \\ldots \\assert{e'_m}, f_1 h_1 e_1 \\ldots f_n h_n e_n } \\\\ \\{ f'_1 \\ldots f'_p \\} = \\{ f\\ |\\ ∃i: f = f_i ∧ (h_i \\mathop{≠} :: \\mathop{∨} b') \\} \\\\ ∀i,j∈\\{1 \\ldots p\\}: i≤j ⇒ f'_i≤f'_j } { \\texttt{std.objectFieldsEx}(e, e') ↓ \\array{f'_1 \\ldots f'_p} }",
              ["Object", "Boolean"],
              "unique-codepoint-sorted-ready-names",
            )
          _ =>
            fail(
              "object reflection completion is restricted to two reviewed rules",
            )
        }
        let head = "\\rule{" + id + "} {"
        let parts = spec.split(head).collect()
        assert_eq(parts.length(), 2)
        let actual = head + parts[1].split("\\]").next().unwrap().to_owned()
        assert_eq(
          normalized(actual),
          statement,
          msg="fixed reflection source mismatch",
        )
        assert_eq(
          text_field(record, "fixed_statement"),
          statement,
          msg="reviewed reflection statement mismatch",
        )
        assert_eq(
          field(record, "argument_domains"),
          domains,
          msg="reflection argument domains",
        )
        assert_eq(
          text_field(record, "result_contract"),
          contract,
          msg="reflection result contract",
        )
        assert_eq(
          text_field(record, "value_demand"),
          "object-head-and-explicit-scalar-arguments-only",
          msg="reflection value demand",
        )
        assert_eq(
          text_field(record, "name_order"),
          if id == "object-fields-ex" {
            "Unicode-codepoint-lexicographic"
          } else {
            "not-applicable"
          },
          msg="reflection name order",
        )
        assert_true(
          !text_field(record, "child_judgments_assumed").is_empty(),
          msg="reflection child assumptions required",
        )
        guard field(record, "excluded_obligations") is Array(excluded) else {
          fail("reflection exclusions required")
        }
        for
          exclusion in [
            "Whole object construction, visibility-inheritance and assertion judgments (N0/R0).",
            "Complete child String/Boolean expression, lexing, invocation and public-library contracts.",
            "A0/B0 and resource/encoding/rounding/Go-C++ acceptance.",
          ] {
          assert_true(
            excluded.contains(Json::string(exclusion)),
            msg="reflection must exclude " + exclusion,
          )
        }
        for name in ["runtime_error", "lazy", "boundary"] {
          assert_true(
            !dimension(row, name).is_empty(),
            msg="reflection evidence gap: " + name,
          )
        }
      } else if form == "error-static-transfer" {
        assert_eq(
          id,
          "chk-error",
          msg="error static completion is restricted to chk-error",
        )
        let statement = "\\rule{chk-error} { Γ ⊢ e } { Γ ⊢ \\error{e} }"
        let head = "\\rule{chk-error} {"
        let parts = spec.split(head).collect()
        assert_eq(parts.length(), 2)
        let actual = head + parts[1].split("\\]").next().unwrap().to_owned()
        assert_eq(
          normalized(actual),
          statement,
          msg="fixed error static source mismatch",
        )
        assert_eq(
          text_field(record, "fixed_statement"),
          statement,
          msg="reviewed error static statement mismatch",
        )
        assert_eq(
          field(record, "premise_roles"),
          Json::array([Json::string("operand")]),
          msg="error static premise role",
        )
        assert_true(!text_field(record, "child_judgments_assumed").is_empty())
        for name in ["static_error", "lazy", "boundary"] {
          assert_true(
            !dimension(row, name).is_empty(),
            msg="error static evidence gap: " + name,
          )
        }
      } else if form == "unary-static-transfer" {
        assert_eq(
          id,
          "chk-unary",
          msg="unary static completion is restricted to chk-unary",
        )
        let statement = "\\rule{chk-unary} { Γ ⊢ e } { Γ ⊢ \\unary{sym}{e} }"
        let head = "\\rule{chk-unary} {"
        let parts = spec.split(head).collect()
        assert_eq(parts.length(), 2)
        let actual = head + parts[1].split("\\]").next().unwrap().to_owned()
        assert_eq(
          normalized(actual),
          statement,
          msg="fixed unary static source mismatch",
        )
        assert_eq(
          text_field(record, "fixed_statement"),
          statement,
          msg="reviewed unary static statement mismatch",
        )
        assert_eq(
          field(record, "premise_roles"),
          Json::array([Json::string("operand")]),
          msg="unary static premise role",
        )
        assert_eq(
          field(record, "operator_domain"),
          Json::array(["-", "+", "!", "~"]),
          msg="unary static operator domain",
        )
        assert_true(
          spec.contains(
            "<td> <code>-</code> | <code>+</code> | <code>!</code> | <code>~</code> </td>",
          ),
        )
        assert_true(!text_field(record, "child_judgments_assumed").is_empty())
        for name in ["static_error", "lazy", "boundary"] {
          assert_true(
            !dimension(row, name).is_empty(),
            msg="unary static evidence gap: " + name,
          )
        }
      } else if form == "assertion-constructor-transfer" {
        let statements = assertion_transfer_statements()
        assert_eq(
          field(record, "fixed_statements"),
          Json::array(statements.map(statement => Json::string(statement))),
          msg="fixed assertion statements mismatch",
        )
        for statement in statements {
          let head = statement.split(" = ").next().unwrap().to_owned() + " ="
          let parts = spec.split(head).collect()
          assert_eq(parts.length(), 2)
          let actual = head + parts[1].split("\\]").next().unwrap().to_owned()
          assert_eq(
            normalized(actual),
            statement,
            msg="fixed assertion source mismatch",
          )
        }
        assert_eq(
          field(record, "premise_roles"),
          Json::array(
            [
              "condition", "optional-message", "continuation", "object-local-bindings",
              "assertion-pairs",
            ].map(role => Json::string(role)),
          ),
        )
        assert_true(
          !text_field(record, "child_judgments_assumed").is_empty(),
          msg="assertion constructor child assumptions required",
        )
        guard field(record, "excluded_obligations") is Array(excluded) else {
          fail("assertion constructor exclusions required")
        }
        for
          exclusion in [
            "N0: Assertion-super rewriting in the object-inherit rule.", "R0: Finite self-index reentry derivation from the state-free object-index rule.",
            "Whole conformance of child expression, binding, Boolean, error, indexing and inheritance judgments.",
          ] {
          assert_true(
            excluded.contains(Json::string(exclusion)),
            msg="assertion constructor must exclude " + exclusion,
          )
        }
        for name in ["runtime_error", "lazy", "boundary"] {
          assert_true(
            !dimension(row, name).is_empty(),
            msg="assertion constructor evidence gap: " + name,
          )
        }
      } else {
        fail("unsupported explicit review form")
      }
      assert_true(!dimension(row, "normal").is_empty() && remaining.is_empty())
      assert_true(
        !text_field(record, "scope").is_empty() &&
        !text_field(record, "reasoning").is_empty(),
      )
      guard field(record, "remaining_in_rule") is Array(open) && open.is_empty() else {
        fail("in-rule obligations remain")
      }
      guard field(record, "excluded_obligations") is Array(excluded) &&
        !excluded.is_empty() else {
        fail("completion needs an explicit boundary")
      }
      ignore(@fs.read_file(text_field(record, "review_report")))
      guard field(record, "not_applicable") is Object(reasons) else {
        fail("N/A reasons")
      }
      if form == "premise-free" || form == "value-head-transfer" {
        assert_true(
          reasons.contains("static_error") && reasons.contains("runtime_error"),
        )
      } else if id.has_prefix("chk-") {
        assert_true(
          reasons.contains("runtime_error") && !reasons.contains("static_error"),
        )
      } else {
        assert_true(
          reasons.contains("static_error") && !reasons.contains("runtime_error"),
        )
      }
      for name, reason in reasons {
        guard reason is String(reason) && !reason.is_empty() else {
          fail("N/A reason")
        }
        assert_true(
          ["static_error", "runtime_error", "lazy", "boundary"].contains(name) &&
          dimension(row, name).is_empty(),
        )
      }
      guard field(record, "inspection") is Array(inspections) &&
        !inspections.is_empty() else {
        fail("constructor inspection required")
      }
      for inspection in inspections {
        let path = text_field(inspection, "file")
        assert_eq(
          sha256(path),
          text_field(inspection, "sha256"),
          msg="inspected implementation changed: " + path,
        )
        assert_true(
          @fs.read_file(path).text().contains(text_field(inspection, "anchor")),
        )
        assert_true(!text_field(inspection, "argument").is_empty())
      }
      guard field(record, "evidence_sha256") is Object(snapshot) &&
        !snapshot.is_empty() else {
        fail("reviewed test snapshot required")
      }
      for path, expected in snapshot {
        assert_eq(
          Json::string(sha256(path)),
          expected,
          msg="reviewed tests changed: " + path,
        )
      }
      if form == "assertion-constructor-transfer" {
        completed_constructors.push((id, record))
      } else {
        completed.push((id, record))
      }
    } else {
      assert_true(
        !remaining.is_empty(),
        msg="partial rows must state remaining obligations",
      )
    }
    guard field(row, "implementation") is Array(paths) else {
      fail("implementation pointers")
    }
    for path in paths {
      guard path is String(path) else { fail("implementation path") }
      ignore(@fs.read_file(path))
    }
    let dimensions : Map[String, Json] = Map([])
    for name in ["normal", "static_error", "runtime_error", "lazy", "boundary"] {
      dimensions[name] = Json::array(dimension(row, name))
    }
    let obligation : String? = if row is Object(fields) {
      match fields.get("obligation") {
        Some(String(text)) => Some(text)
        _ => None
      }
    } else {
      None
    }
    enriched.push({
      "id": id,
      "kind": field(item, "kind"),
      "section": field(item, "section"),
      "source_line": field(item, "source_line"),
      "state": state,
      "dimensions": dimensions,
      "remaining": remaining,
      "implementation": paths,
      "obligation": obligation,
      "rule_review": review,
    })
    markdown.write_string(
      "| [" +
      id +
      "](" +
      source_base +
      "#" +
      text_field(item, "section") +
      ")" +
      (if review is Some(_) {
        if text_field(item, "kind") == "prose-or-grammar-obligation" {
          " **complete constructor transfer (relative)**"
        } else if id.has_prefix("chk-") {
          " **complete static rule**"
        } else {
          " **complete evaluation rule**"
        }
      } else {
        ""
      }) +
      " |",
    )
    for name in ["normal", "static_error", "runtime_error", "lazy", "boundary"] {
      markdown.write_string(" " + dimension_text(row, name) + " |")
    }
    markdown.write_string(
      " " +
      (if review is Some(_) {
        if text_field(item, "kind") == "prose-or-grammar-obligation" {
          "None within this constructor transfer relative to its children; normative child gaps and exclusions remain explicit below."
        } else {
          "None within this named judgment; see explicit exclusions and child assumptions below."
        }
      } else {
        remaining
      }) +
      " |\n",
    )
  }
  assert_eq(used.length(), evidence.length(), msg="orphan evidence mappings")
  if !completed.is_empty() {
    markdown.write_string(
      "\n## Completed named-rule reviews\n\nThese are recorded manual decisions from constructor case analysis plus executed controls. The tool checks empty premises for premise-free judgments, or exact fixed statements and premise roles for the explicitly supported conditional, Boolean shortcut, sequence-length, object-reflection, object-head, chk-error and chk-unary transfer judgments. The sequence form is restricted to length-array/string, pins element/codepoint units, and excludes the array-concat formal index discrepancy A0. The Boolean form is restricted to the two explicit shortcut rules and excludes the longcut non-Boolean RHS domain B0. The reflection form is restricted to object-has-ex/fields-ex, pins Object/String/Boolean domains, exact name membership or sorted unique name output, excludes payload demand and retains N0/R0/A0/B0 boundaries. The object-head form is restricted to length-object/type-object, preserves the raw length delimiter blemish and explicit composition interpretation, checks the fixed public field-count source and completed dependencies, and excludes nested value/assertion demand and N0/R0. The comparison-sign form pins the six unambiguous <, <= and >= equations, ordered operands and admitted cmp signs -1/0/1; it excludes greater-than formulas and whole comparator child judgments. The Boolean-negation form pins only not-true/not-false, their strict Boolean operand and opposite result, ! and operand-head-only demand; it assumes the operand child and excludes other unary and whole static/grammar judgments. The static-pair whitelist reuses the fixed-statement/premise-role checks only for chk-array-index and chk-binary, preserving target/index or left/right roles and assuming the unchanged-Gamma child judgments; runtime type/integer/range and operator evaluation obligations remain separate. The value-head entry pins the exact Primitive/Function/Array membership and identity equation; it requires canonical finite members and explicit delayed-child scope, excluding raw numeric conversion, Object construction and manifestation. The unary record also pins the four-symbol grammar domain. It checks inspected implementation/test hashes and explicit scope; source/name matches do not prove semantic correctness. Transfer judgments assume their child judgments and do not complete other language rules or whole-language acceptance.\n\n",
    )
    for (id, record) in completed {
      let report = text_field(record, "review_report")
        .strip_prefix("docs/development/")
        .unwrap()
        .to_owned()
      markdown.write_string(
        "- **" +
        id +
        "**: " +
        text_field(record, "scope") +
        " " +
        text_field(record, "reasoning") +
        " [Criteria and exclusions](" +
        report +
        ").\n",
      )
    }
  }
  if !completed_constructors.is_empty() {
    markdown.write_string(
      "\n## Completed constructor-transfer reviews\n\nThese prose constructor decisions are separate from completed named inference rules. They assume the listed child judgments and exclude unresolved normative child rules. The tool pins exact fixed desugaring statements, inspected source/test hashes and mandatory exclusions; it does not infer semantic correctness, execution or whole-language acceptance.\n\n",
    )
    for (id, record) in completed_constructors {
      let report = text_field(record, "review_report")
        .strip_prefix("docs/development/")
        .unwrap()
        .to_owned()
      markdown.write_string(
        "- **" +
        id +
        "**: " +
        text_field(record, "scope") +
        " " +
        text_field(record, "reasoning") +
        " Assumed children: " +
        text_field(record, "child_judgments_assumed") +
        " [Review and unresolved normative children](" +
        report +
        ").\n",
      )
    }
  }
  markdown.write_string(
    "\n## Assertion evidence\n\nMapping schema v2 rejects duplicate keys in every JSON object and requires globally unique canonical file::case test IDs. Each anchor must occur inside its selected named case. Each description records what was checked in the assertion body; a declaration name or a textual anchor alone proves no semantic result. Shared evidence is counted once, regardless of how many clauses cite it. Implementation paths and individual dimensions are retained in [the machine-readable matrix](spec-language-matrix.json).\n\n",
  )
  markdown.write_string(
    "| ID | Exact test block | Reviewed assertion meaning |\n| --- | --- | --- |\n",
  )
  for id, item in locations {
    markdown.write_string(
      "| " +
      id +
      " | [" +
      text_field(item, "file") +
      "](../../" +
      text_field(item, "file") +
      "): `" +
      text_field(item, "test") +
      "` | " +
      text_field(item, "checks") +
      " |\n",
    )
  }
  markdown.write_string(
    "\nLexical UTF-8/tokenization, full grammar/precedence, unassigned chk-* rules, recursive comprehension/desugaring details and all unassigned operator rules remain open. The public standard-library inventory, eleven array observations, removeAt naming and Unicode surrogate ambiguity retain their existing status.\n",
  )
  let result : Json = {
    "spec_commit": pinned,
    "spec_sha256": spec_hash,
    "language_reference_sha256": language_hash,
    "mapping_sha256": sha256(mapping_path),
    "tool_sha256": sha256("tools/spec-language-matrix.mbtx"),
    "mapping_schema_version": 2,
    "global_test_ids": test_ids.length(),
    "named_rules": rule_lines.length(),
    "prose_grammar_rows": clauses.length(),
    "manually_reviewed_subset_rows": reviewed,
    "completed_rule_rows": completed.length(),
    "completed_constructor_rows": completed_constructors.length(),
    "completed_static_rule_rows": completed
    .filter(pair => pair.0.has_prefix("chk-"))
    .length(),
    "completed_evaluation_rule_rows": completed
    .filter(pair => !pair.0.has_prefix("chk-"))
    .length(),
    "unreviewed_rows": rows.length() -
    reviewed -
    completed.length() -
    completed_constructors.length(),
    "complete_conformance": false,
    "execution_inferred": false,
    "evidence": locations,
    "test_file_sha256": test_hashes,
    "clauses": enriched,
  }
  @fs.mkdir(output, recursive=true, allow_exist=true)
  let json = result.stringify(indent=2) + "\n"
  @fs.write_file(
    "docs/development/SPEC-LANGUAGE-MATRIX.md",
    markdown.to_string(),
  )
  @fs.write_file("docs/development/spec-language-matrix.json", json)
  @fs.write_file(output + "/matrix.json", json)
  @fs.write_file(
    output + "/validation.json",
    Json::object(
      Map([
        ("source_head", Json::string(checked("git", ["rev-parse", "HEAD"]))),
        (
          "tracked_diff",
          Json::string(checked("git", ["diff", "HEAD", "--stat"])),
        ),
        (
          "matrix_sha256",
          Json::string(sha256("docs/development/spec-language-matrix.json")),
        ),
        (
          "markdown_sha256",
          Json::string(sha256("docs/development/SPEC-LANGUAGE-MATRIX.md")),
        ),
      ]),
    ).stringify(indent=2) +
    "\n",
  )
  println(
    "Enumerated \{rule_lines.length()} named rules and \{clauses.length()} prose/grammar rows; \{completed.length()} completed named-rule reviews, \{completed_constructors.length()} completed constructor-transfer reviews relative to children, \{reviewed} partial rows, \{rows.length() - reviewed - completed.length() - completed_constructors.length()} unreviewed rows. No execution or whole-language acceptance inferred.",
  )
}
