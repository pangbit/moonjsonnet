import {"moonbitlang/async","moonbitlang/async/fs","moonbitlang/async/shell","moonbitlang/core/env","moonbitlang/core/json"}
fn field(value : Json,key : String,fallback : Json) -> Json {
  match value {Object(fields)=>fields.get(key).unwrap_or(fallback);_=>fallback}
}
async fn command(program : String,args : Array[String]) -> String {
  let result=@shell.Cmd(program,args).output();result.check();result.stdout().trim().to_owned()
}
async fn main {
  let args=@env.args()
  guard args.length()==3 else {fail("Usage: moon run tools/lint-integration.mbtx PROBE GO_CHECKOUT")}
  let cli=@fs.realpath(args[1]);let checkout=@fs.realpath(args[2])
  assert_eq(command("git",["-C",checkout,"rev-parse","HEAD"]),"67968688d9952f50662e979fab1bef889d0d3e57")
  assert_eq(command("git",["-C",checkout,"status","--porcelain"]),"")
  let work=@fs.tmpdir(prefix="moonjsonnet-lint-")
  let adapter=@fs.realpath("tests/reference/lint.go")
  let reference=work+"/go-lint"
  @shell.Cmd("go",["-C",checkout,"build","-o",reference,adapter],env=Map([("GOTOOLCHAIN","go1.24.0"),("GOWORK","off"),("GOPROXY","off")])).run()
  let build=command("go",["version","-m",reference]);assert_true(build.contains("go1.24.0"))
  let fixture=@json.parse(@fs.read_file("tests/go-lint.json").text())
  guard field(fixture,"cases",null) is Array(cases) else {fail("fixtures")}
  assert_eq(field(fixture,"reference_commit",null),Json::string("67968688d9952f50662e979fab1bef889d0d3e57"))
  let rows : Array[Json]=[];let mut passed=0;let mut focused_passed=0;let mut focused_total=0
  let mut reference_crashes=0
  let mut location_total=0;let mut location_passed=0
  for case in cases {
    let input=match case {Object(fields)=>Json::object(fields.copy());_=>Json::null()}
    if input is Object(fields) && !fields.contains("files") {fields["files"]=field(fixture,"files",{})}
    let runs : Array[Json]=[]
    let mut valid=true
    let outcomes : Array[Json]=[]
    for binary in [cli,reference] {
      let result=@shell.Cmd(binary,[],stdin=@shell.Text(input.stringify())).output(timeout_ms=10000)
      let outcome=try @json.parse(result.stdout()) catch {_=>Json::null()}
      if binary==reference && result.exit_code()!=0 && (result.stderr().has_prefix("panic:") || result.stderr().has_prefix("fatal error:")) {reference_crashes+=1}
      let messages=field(outcome,"messages",null)
      let ok=result.exit_code()==0 && result.stderr()=="" && messages is Array(messages) && field(outcome,"found",null)==Json::boolean(!messages.is_empty()) && !result.stdout().contains("(CRASH)") && !result.stdout().contains("INTERNAL ERROR")
      valid=valid && ok
      runs.push({"binary":binary,"exit":result.exit_code(),"stdout":result.stdout(),"stderr":result.stderr(),"valid":ok})
      outcomes.push(outcome)
    }
    let actual=field(outcomes[0],"messages",null);let expected=field(outcomes[1],"messages",null)
    let locations_ok=match field(case,"locations",null) {
      Array(locations)=>field(outcomes[0],"locations",null)==Json::array(locations) && field(outcomes[1],"locations",null)==Json::array(locations)
      _=>true
    }
    let ok=valid && actual==expected && field(case,"expected",expected)==expected && locations_ok
    if field(case,"locations",null) is Array(_) {location_total+=1;if ok {location_passed+=1}}
    let focused=field(case,"group",null)==Json::string("focused")
    if focused {focused_total+=1;if ok {focused_passed+=1}}
    if ok {passed+=1} else {println("FAIL lint "+field(case,"name",null).stringify())}
    rows.push({"fixture":case,"passed":ok,"runs":runs})
  }
  @fs.mkdir("_build/lint",recursive=true,allow_exist=true)
  let report : Json={"source_commit":command("git",["rev-parse","HEAD"]),"source_dirty":command("git",["status","--porcelain"])!="","reference_commit":"67968688d9952f50662e979fab1bef889d0d3e57","local_sha256":command("shasum",["-a","256",cli]),"reference_sha256":command("shasum",["-a","256",reference]),"adapter_sha256":command("shasum",["-a","256",adapter]),"reference_build":build,"total":cases.length(),"passed":passed,"failed":cases.length()-passed,"reference_crashes":reference_crashes,"focused_total":focused_total,"focused_passed":focused_passed,"location_total":location_total,"location_passed":location_passed,"cases":rows}
  @fs.write_file("_build/lint/report.json",report.stringify(indent=2)+"\n")
  println("Lint: \{passed}/\{cases.length()}; focused \{focused_passed}/\{focused_total}; reference crashes: \{reference_crashes}; evidence: \{work}")
  if passed!=cases.length() {fail("lint differences retained in _build/lint/report.json")}
}
