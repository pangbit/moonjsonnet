import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/core/json",
}

async fn main {
  let args = @env.args()
  guard args.length() == 2 else { fail("Usage: moon run tools/embed-unicode.mbtx GO124_UNICODE_TABLES_GO") }
  let hash = @shell.Cmd("shasum", ["-a", "256", args[1]]).output()
  hash.check()
  assert_true(hash.stdout().has_prefix("80a109e5dd4ed40a85d69ddf95175f647bbd68c577d27eb475cda63790bb2487 "))
  let source = @fs.read_file(args[1]).text()
  assert_true(source.contains("const Version = \"15.0.0\""))
  let next : Map[Int, Int] = Map([])
  let mut section = ""
  for line in source.split("\n") {
    if line == "var _CaseRanges = []CaseRange{" { section = "ranges"; continue }
    if line == "var caseOrbit = []foldPair{" { section = "orbits"; continue }
    if line == "}" { section = "" }
    if section.is_empty() { continue }
    let columns = line.to_owned().replace(old="d{", new="").replace(old="{", new="").replace(old="}", new="").split(",").map(x => x.trim().to_owned()).collect()
    let first = @string.parse_int(columns[0], base=0)
    let second = @string.parse_int(columns[1], base=0)
    if section == "orbits" { next[first] = second; continue }
    for c in first..=second {
      let folded = if columns[2] == "UpperLower" {
        first + ((c - first) ^ 1)
      } else {
        let lower = @string.parse_int(columns[3])
        c + (if lower != 0 { lower } else { @string.parse_int(columns[2]) })
      }
      next[c] = folded
    }
  }
  let keys = next.keys().collect()
  keys.sort()
  let result = StringBuilder()
  result.write_string("// Generated by tools/embed-unicode.mbtx from Go 1.24.0 unicode/tables.go.\n// Unicode 15.0.0 simple fold equivalence representatives.\n// Copyright 2009 The Go Authors. BSD terms: licenses/GO-BSD-3-Clause.txt.\n\n///|\nlet unicode_fold : Map[Int, Int] = {\n")
  let pairs : Array[Json] = []
  for key in keys {
    let mut canonical = key
    let mut cursor = next[key]
    let mut steps = 0
    while cursor != key {
      canonical = Int::min(canonical, cursor)
      cursor = next[cursor]
      steps += 1
      assert_true(steps < 10)
    }
    if canonical != key { result.write_string("  \{key}: \{canonical},\n") }
    pairs.push([key, canonical])
  }
  result.write_string("}\n")
  @fs.write_file("unicode_fold.mbt", result.to_string())
  @fs.write_file("tests/unicode-fold-pairs.json", Json::array(pairs).stringify())
  println("Embedded simple-fold representatives and \{pairs.length()} reference test pairs.")
}
