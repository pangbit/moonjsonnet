import {"moonbitlang/async","moonbitlang/async/fs","moonbitlang/async/shell","moonbitlang/core/env"}
async fn main {
  let args=@env.args()
  guard args.length()==2 else {fail("Usage: moon run tools/embed-lint-print.mbtx GO124_STRCONV_ISPRINT_GO")}
  let hash=@shell.Cmd("shasum",["-a","256",args[1]]).output();hash.check()
  assert_true(hash.stdout().has_prefix("24114557c2b3cad7b80c8e71683831bfbe1c72eb99e8fd28a3a48eaf77705fb4 "))
  let names=Map([("isPrint16","lint_print16"),("isNotPrint16","lint_not_print16"),("isPrint32","lint_print32"),("isNotPrint32","lint_not_print32")])
  let out=StringBuilder()
  out.write_string("// Generated by tools/embed-lint-print.mbtx from Go 1.24.0 strconv/isprint.go.\n// Copyright 2009 The Go Authors. BSD terms: licenses/GO-BSD-3-Clause.txt.\n// Source SHA-256: 24114557c2b3cad7b80c8e71683831bfbe1c72eb99e8fd28a3a48eaf77705fb4\n")
  let mut active=false
  let mut count=0
  for line in @fs.read_file(args[1]).text().split("\n") {
    if line.has_prefix("var ") {
      let name=line.split(" ").collect()[1].to_owned()
      if names.get(name) is Some(target) {out.write_string("\n///|\nlet "+target+" : Array[Int] = [\n");active=true;count+=1}
      continue
    }
    if active {
      if line=="}" {out.write_string("]\n");active=false;continue}
      for token in line.split(",") {
        let token=token.trim().to_owned()
        if token.has_prefix("0x") {out.write_string("  "+token+",\n")}
      }
    }
  }
  assert_eq(count,4)
  @fs.write_file("lint_print.mbt",out.to_string())
}
