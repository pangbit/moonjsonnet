import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
}

async fn main {
  let args = @env.args()
  guard args.length() == 1 || args.length() == 2 else {
    fail("Usage: moon run tools/asan.mbtx [GO_CHECKOUT for fresh CLI diagnostic checks]")
  }
  let home = @env.get_env_var("MOON_HOME").unwrap_or(@env.get_env_var("HOME").unwrap() + "/.moon")
  let work = @fs.tmpdir(prefix="moonjsonnet-asan-")
  let repo = @fs.realpath(".")
  let shadow = work + "/toolchain"
  let checkout = work + "/source"
  @fs.mkdir(shadow)
  @fs.mkdir(checkout)
  @shell.Cmd("cp", ["-R", home + "/lib", shadow + "/lib"]).run()
  if @fs.exists(home + "/include") { @shell.Cmd("cp", ["-R", home + "/include", shadow + "/include"]).run() }
  @fs.symlink(target=home + "/bin", shadow + "/bin")
  // Only the temporary toolchain copy is changed. The installed runtime remains
  // untouched. Disable mimalloc so ASan can observe libc malloc/free allocations.
  @fs.write_file(work + "/empty.c", "/* ASan uses system allocation. */\n")
  @shell.Cmd("cc", ["-c", work + "/empty.c", "-o", shadow + "/lib/libmoonbitrun.o"]).run()
  let files = @shell.Cmd("git", ["ls-files"], cwd=repo).output()
  files.check()
  for file in files.stdout().split("\n") {
    if file.is_empty() { continue }
    let relative = file.to_owned()
    if relative == "README.md" { continue }
    let dest = checkout + "/" + relative
    if dest.rev_find("/") is Some(i) { @fs.mkdir(dest[:i], recursive=true, allow_exist=true) }
    @shell.Cmd("cp", [repo + "/" + relative, dest]).run()
    if relative.has_suffix("moon.pkg") || relative == "moon.pkg" {
      let text = @fs.read_file(dest).text()
      let flags = "link: { \"native\": { \"cc\": \"cc\", \"cc-flags\": \"-g -fsanitize=address -fno-omit-frame-pointer\", \"stub-cc-flags\": \"-g -fsanitize=address -fno-omit-frame-pointer\" } }"
      let patched = if text.contains("options(") {
        text.replace(old="options(", new="options(" + flags + ", ")
      } else { text + "\noptions(" + flags + ")\n" }
      @fs.write_file(dest, patched)
    }
  }
  // Keep sanitizer failures distinct from expected interpreter errors (exit 1).
  let asan_options = "detect_leaks=0:fast_unwind_on_malloc=0:exitcode=99"
  let environment = Map([("MOON_HOME", shadow), ("ASAN_OPTIONS", asan_options)])
  @shell.Cmd("moon", ["test", "--target", "native", "--deny-warn"], cwd=checkout, env=environment).run()
  @shell.Cmd("moon", ["run", "--build-only", "--target", "native", "cmd/main"], cwd=checkout, env=environment).run()
  @shell.Cmd("moon", ["run", repo + "/tools/integration.mbtx", checkout + "/_build/native/debug/build/cmd/main/main.exe"], cwd=checkout,
    env=Map([("MOON_HOME", home), ("ASAN_OPTIONS", asan_options)])).run()
  if args.length() == 2 {
    let go_checkout = @fs.realpath(args[1])
    @shell.Cmd("moon", ["run", repo + "/tools/diagnostic-cli.mbtx", checkout + "/_build/native/debug/build/cmd/main/main.exe", go_checkout], cwd=checkout,
      env=Map([("MOON_HOME", home), ("ASAN_OPTIONS", asan_options)])).run()
    @shell.Cmd("moon", ["run", repo + "/tools/diagnostic-terminal.mbtx", checkout + "/_build/native/debug/build/cmd/main/main.exe", go_checkout + "/jsonnet"], cwd=checkout,
      env=Map([("MOON_HOME", home), ("ASAN_OPTIONS", asan_options)])).run()
    @shell.Cmd("moon", ["run", repo + "/tools/cli-argument-diagnostics.mbtx", checkout + "/_build/native/debug/build/cmd/main/main.exe", go_checkout + "/jsonnet"], cwd=checkout,
      env=Map([("MOON_HOME", home), ("ASAN_OPTIONS", asan_options)])).run()
  }
  @shell.Cmd("moon", ["run", "--build-only", "--target", "native", "cmd/deps"], cwd=checkout, env=environment).run()
  @shell.Cmd("moon", ["run", repo + "/tools/dependency-integration.mbtx", checkout + "/_build/native/debug/build/cmd/deps/deps.exe"], cwd=checkout,
    env=Map([("MOON_HOME", home), ("ASAN_OPTIONS", asan_options)])).run()
  @shell.Cmd("moon", ["run", "--build-only", "--target", "native", "examples/parameter-probe"], cwd=checkout, env=environment).run()
  @shell.Cmd("moon", ["run", repo + "/tools/parameter-integration.mbtx", checkout + "/_build/native/debug/build/examples/parameter-probe/parameter-probe.exe"], cwd=checkout,
    env=Map([("MOON_HOME", home), ("ASAN_OPTIONS", asan_options)])).run()
  @shell.Cmd("moon", ["run", "--build-only", "--target", "native", "examples/evaluator-probe"], cwd=checkout, env=environment).run()
  @shell.Cmd("moon", ["run", repo + "/tools/evaluator-integration.mbtx", checkout + "/_build/native/debug/build/examples/evaluator-probe/evaluator-probe.exe"], cwd=checkout,
    env=Map([("MOON_HOME", home), ("ASAN_OPTIONS", asan_options)])).run()
  @shell.Cmd("moon", ["run", "--build-only", "--target", "native", "examples/ast-probe"], cwd=checkout, env=environment).run()
  @shell.Cmd("moon", ["run", repo + "/tools/ast-integration.mbtx", checkout + "/_build/native/debug/build/examples/ast-probe/ast-probe.exe"], cwd=checkout,
    env=Map([("MOON_HOME", home), ("ASAN_OPTIONS", asan_options)])).run()
  @shell.Cmd("moon", ["run", "--build-only", "--target", "native", "cmd/lint"], cwd=checkout, env=environment).run()
  @shell.Cmd("moon", ["run", repo + "/tools/lint-cli.mbtx", checkout + "/_build/native/debug/build/cmd/lint/lint.exe"], cwd=checkout,
    env=Map([("MOON_HOME", home), ("ASAN_OPTIONS", asan_options)])).run()
  @shell.Cmd("moon", ["run", "--build-only", "--target", "native", "cmd/jsonnetfmt"], cwd=checkout, env=environment).run()
  @shell.Cmd("moon", ["run", repo + "/tools/formatter-cli-host.mbtx", checkout + "/_build/native/debug/build/cmd/jsonnetfmt/jsonnetfmt.exe"], cwd=checkout,
    env=Map([("MOON_HOME", home), ("ASAN_OPTIONS", asan_options)])).run()
  @shell.Cmd("moon", ["run", "--build-only", "--target", "native", "examples/formatter-node-probe"], cwd=checkout, env=environment).run()
  @shell.Cmd("moon", ["run", repo + "/tools/formatter-node.mbtx", checkout + "/_build/native/debug/build/examples/formatter-node-probe/formatter-node-probe.exe"], cwd=checkout,
    env=Map([("MOON_HOME", home), ("ASAN_OPTIONS", asan_options)])).run()
  @shell.Cmd("moon", ["run", "--build-only", "--target", "native", "examples/debugger-probe"], cwd=checkout, env=environment).run()
  @shell.Cmd("moon", ["run", repo + "/tools/debugger-integration.mbtx", checkout + "/_build/native/debug/build/examples/debugger-probe/debugger-probe.exe"], cwd=checkout,
    env=Map([("MOON_HOME", home), ("ASAN_OPTIONS", asan_options)])).run()
  @shell.Cmd("moon", ["run", "--build-only", "--target", "native", "examples/diagnostic-probe"], cwd=checkout, env=environment).run()
  @shell.Cmd("moon", ["run", repo + "/tools/diagnostic-api.mbtx", checkout + "/_build/native/debug/build/examples/diagnostic-probe/diagnostic-probe.exe"], cwd=checkout,
    env=Map([("MOON_HOME", home), ("ASAN_OPTIONS", asan_options)])).run()
  println("ASan tests and host integration passed with isolated toolchain: \{work}; leak detection disabled")
}
