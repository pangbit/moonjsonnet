[
  {
    "name": "cli-exec-expression",
    "source": "local n=21; {answer:n*2}",
    "input": "exec",
    "args": [
      "-e"
    ],
    "expect": "success",
    "result": {
      "answer": 42
    }
  },
  {
    "name": "cli-exec-long-option",
    "source": "[1,true,'é😀']",
    "input": "exec",
    "args": [
      "--exec"
    ],
    "expect": "success",
    "result": [
      1,
      true,
      "é😀"
    ]
  },
  {
